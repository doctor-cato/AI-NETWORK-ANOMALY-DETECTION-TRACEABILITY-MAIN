---
import Layout from "../layouts/Layout.astro";
import PageIntro from "../components/PageIntro.astro";
import { source, issue, pull } from "../lib/links";
const layers = [
    [
        "Data acquisition & validation",
        "Tested",
        "Official-source fetcher, manifest, streaming quality checks and EDA are in main.",
        source("docs/dataset/NF_UNSW_NB15_V3_PROVENANCE.md"),
    ],
    [
        "Split & preprocessing",
        "Implemented",
        "Chronological split manifest and train-only preprocessing code exist; artifact hash-chain review remains.",
        source("docs/NF_UNSW_NB15_V3_PREPROCESSING_POLICY.md"),
    ],
    [
        "RF & XGBoost",
        "Validation reported",
        "Supervised model code and Validation reports are present. Final Test metrics are not published.",
        source("reports/models/rf_baseline_training_report.md"),
    ],
    [
        "Isolation Forest",
        "Implemented",
        "Model and training script exist; recorded real-data run was blocked.",
        issue(11),
    ],
    [
        "Autoencoder",
        "In progress",
        "Proposed in PR #51; not merged into main.",
        pull(51),
    ],
    [
        "Behavioral correlation & risk",
        "Planned",
        "Versioned behavioral vector, confidence and calibrated 0–100 risk are roadmap goals.",
        issue(32),
    ],
    [
        "Traceability & secure storage",
        "Planned",
        "Evidence-linked incidents, AES-GCM and key lifecycle remain roadmap goals.",
        issue(24),
    ],
    [
        "API & user interface",
        "In progress",
        "FastAPI/SQLite is proposed in PR #52; Streamlit remains planned.",
        pull(52),
    ],
];
---

<Layout
    title="System Architecture"
    description="Intended architecture and the implementation state of every layer."
    section="Architecture"
>
    <PageIntro
        eyebrow="05 / Architecture"
        current="Architecture"
        title="A system design with visible seams."
        description="The architecture connects verified flow data to possible model, correlation and trace layers. Solid nodes show work on main; dashed nodes mark target capabilities or code in open PRs."
    />
    <section class="section">
        <div class="container">
            <div class="diagram-head">
                <div>
                    <span class="eyebrow">Target system</span><h2>
                        From flow record to evidence trail.
                    </h2>
                </div><div class="diagram-legend">
                    <span><i></i> On main</span><span
                        ><i></i> Planned / open PR</span
                    >
                </div>
            </div><div class="diagram-wrap surface">
                <svg
                    role="img"
                    aria-labelledby="diagram-title diagram-desc"
                    viewBox="0 0 1040 610"
                    xmlns="http://www.w3.org/2000/svg"
                    ><title id="diagram-title">
                        Intended network anomaly detection architecture
                    </title><desc id="diagram-desc"
                        >Data acquisition and validation lead to preprocessing,
                        models, risk scoring and traceability, then secure
                        storage, API and user interface. Only the initial data
                        and model code is on main.</desc
                    ><defs
                        ><marker
                            id="arrow"
                            markerWidth="8"
                            markerHeight="8"
                            refX="7"
                            refY="4"
                            orient="auto"
                            ><path d="M0 0 L8 4 L0 8" fill="#66e1e8"
                            ></path></marker
                        ></defs
                    >
                    <g
                        fill="none"
                        stroke="#66e1e8"
                        stroke-width="2"
                        marker-end="url(#arrow)"
                        ><path d="M235 100H305"></path><path d="M495 100H565"
                        ></path><path d="M755 100H825"></path><path
                            d="M660 144V230"></path><path d="M660 310V390"
                        ></path><path d="M565 435H495"></path><path
                            d="M305 435H235"></path><path d="M400 480V555"
                        ></path></g
                    >
                    <g fill="#132b3d" stroke="#66e1e8" stroke-width="2"
                        ><rect x="25" y="55" width="210" height="90" rx="5"
                        ></rect><rect
                            x="305"
                            y="55"
                            width="190"
                            height="90"
                            rx="5"></rect><rect
                            x="565"
                            y="55"
                            width="190"
                            height="90"
                            rx="5"></rect><rect
                            x="825"
                            y="55"
                            width="190"
                            height="90"
                            rx="5"></rect></g
                    >
                    <g
                        fill="#152334"
                        stroke="#778ca0"
                        stroke-width="2"
                        stroke-dasharray="7 6"
                        ><rect x="565" y="230" width="190" height="80" rx="5"
                        ></rect><rect
                            x="565"
                            y="390"
                            width="190"
                            height="90"
                            rx="5"></rect><rect
                            x="305"
                            y="390"
                            width="190"
                            height="90"
                            rx="5"></rect><rect
                            x="25"
                            y="390"
                            width="210"
                            height="90"
                            rx="5"></rect><rect
                            x="305"
                            y="555"
                            width="190"
                            height="45"
                            rx="5"></rect></g
                    >
                    <g
                        font-family="ui-sans-serif,system-ui"
                        fill="#e8f6f8"
                        font-size="17"
                        font-weight="700"
                        ><text x="45" y="91">Acquire + validate</text><text
                            x="325"
                            y="91">Preprocess</text
                        ><text x="585" y="91">RF / XGBoost</text><text
                            x="845"
                            y="91">Isolation Forest</text
                        ><text x="585" y="265">Autoencoder</text><text
                            x="585"
                            y="425">Risk + correlation</text
                        ><text x="325" y="425">Trace Engine</text><text
                            x="45"
                            y="425">Secure storage</text
                        ><text x="365" y="585">API + UI</text></g
                    >
                    <g
                        font-family="ui-sans-serif,system-ui"
                        fill="#9fb3c4"
                        font-size="12"
                        ><text x="45" y="119">verified source</text><text
                            x="325"
                            y="119">train-only contract</text
                        ><text x="585" y="119">Validation reports</text><text
                            x="845"
                            y="119">code; run blocked</text
                        ><text x="585" y="290">open PR #51</text><text
                            x="585"
                            y="452">planned scoring</text
                        ><text x="325" y="452">planned incident trail</text
                        ><text x="45" y="452">planned AES-GCM</text></g
                    ></svg
                >
            </div><p class="diagram-note">
                NF-UNSW-NB15-v3 contains NetFlow fields, not API, authentication
                or application-session events. Those would require separate
                future sources. An IP address is metadata, not identity proof.
            </p>
        </div>
    </section>
    <section class="section rule tinted">
        <div class="container">
            <span class="eyebrow">Implementation inventory</span><h2>
                What each layer can claim today.
            </h2><div class="table-wrap">
                <table class="data-table">
                    <caption class="sr-only"
                        >Architecture layers, implementation status and evidence</caption
                    ><thead
                        ><tr
                            ><th scope="col">Layer</th><th scope="col"
                                >Current status</th
                            ><th scope="col">Evidence boundary</th><th
                                scope="col">Source</th
                            ></tr
                        ></thead
                    ><tbody
                        >{
                            layers.map(([name, status, note, link]) => (
                                <tr>
                                    <>
                                        <th scope="row">{name}</th>
                                        <td>{status}</td>
                                        <td>{note}</td>
                                        <td>
                                            <a href={link}>Inspect ↗</a>
                                        </td>
                                    </>
                                </tr>
                            ))
                        }</tbody
                    >
                </table>
            </div>
        </div>
    </section>
</Layout>
<style>
    .diagram-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 2rem;
    }
    .diagram-head h2 {
        margin: 0.6rem 0 1.5rem;
    }
    .diagram-legend {
        display: flex;
        gap: 1.4rem;
        color: var(--muted);
        font-size: 0.78rem;
        margin-bottom: 1.5rem;
    }
    .diagram-legend span {
        display: flex;
        gap: 0.4rem;
        align-items: center;
    }
    .diagram-legend i {
        display: block;
        width: 12px;
        height: 12px;
        border: 2px solid var(--cyan);
    }
    .diagram-legend span:last-child i {
        border-color: var(--muted);
        border-style: dashed;
    }
    .diagram-wrap {
        overflow: auto;
        padding: 1.5rem;
        background: #0b1929;
    }
    .diagram-wrap svg {
        display: block;
        min-width: 700px;
        width: 100%;
        height: auto;
    }
    .diagram-note {
        color: var(--muted);
        font-size: 0.85rem;
    }
    .tinted {
        background: var(--surface);
    }
    .data-table a {
        color: var(--cyan);
    }
    .data-table td {
        color: var(--muted);
    }
    @media (max-width: 700px) {
        .diagram-head {
            display: block;
        }
        .diagram-legend {
            flex-wrap: wrap;
        }
    }
</style>
