---
import Layout from "../../layouts/Layout.astro";
import PageIntro from "../../components/PageIntro.astro";
import { source, type Lang } from "../../lib/links";

interface Props {
  lang?: Lang;
  categories: [string, string][];
}
const { lang = "vi", categories } = Astro.props;
const isVi = lang === "vi";
---

<Layout
  title={isVi ? "Bộ dữ liệu" : "Dataset"}
  description={isVi
    ? "Nguồn gốc AIT-NDS-v2, hợp đồng canonical-flow-v2-18, phân bố 5 họ tấn công và kiểm định đa nguồn CTU-SME-11 / UWF-ZeekData24."
    : "AIT-NDS-v2 provenance, canonical-flow-v2-18 contract, 5-category distribution and CTU-SME-11 / UWF-ZeekData24 multi-source boundaries."}
  section="Dataset"
  lang={lang}
  routePath="dataset/"
>
  <PageIntro
    eyebrow={isVi ? "02 / Nguồn dữ liệu v2.0" : "02 / Data provenance v2.0"}
    current={isVi ? "Bộ dữ liệu" : "Dataset"}
    title={isVi
      ? "AIT-NDS-v2, kiểm tra từ byte gốc."
      : "AIT-NDS-v2, examined at the source."}
    description={isVi
      ? "Sau bước Hard Cutover khỏi v1 (NF-UNSW-NB15-v3 chuyển vào historical/nf_unsw_nb15_v3/), NetFlow Sentinel v2.0 sử dụng AIT-NDS-v2 làm nguồn huấn luyện/đánh giá chính cùng CTU-SME-11 và UWF-ZeekData24 cho đánh giá ngoại vi."
      : "Following the Hard Cutover from v1 (NF-UNSW-NB15-v3 retired to historical/nf_unsw_nb15_v3/), NetFlow Sentinel v2.0 uses AIT-NDS-v2 as its primary benchmark alongside CTU-SME-11 and UWF-ZeekData24 for external evaluation."}
    lang={lang}
  />
  <section class="section">
    <div class="container">
      <div class="facts">
        <div>
          <small>{isVi ? "Bộ dữ liệu chính" : "Primary suite"}</small><strong
            >AIT-NDS-v2 (8 scenarios)</strong
          >
        </div><div>
          <small>{isVi ? "Định danh ổn định" : "Stable record"}</small><strong
            ><a href="https://doi.org/10.5281/zenodo.13168643"
              >DOI 10.5281/zenodo.13168643 ↗</a
            ></strong
          >
        </div><div>
          <small>{isVi ? "Tổng dòng có nhãn" : "Verified labeled"}</small
          ><strong
            >{
              isVi
                ? "3,464,400 dòng · +942 loại trừ"
                : "3,464,400 rows · +942 excluded"
            }</strong
          >
        </div><div>
          <small>{isVi ? "Giấy phép" : "License"}</small><strong
            >CC BY 4.0 (AIT-NDS-v2 & CTU-SME-11)</strong
          >
        </div>
      </div>
    </div>
  </section>
  <section class="section rule">
    <div class="container two-column">
      <div>
        <span class="eyebrow">{isVi ? "Phân bố lớp" : "Population"}</span><h2>
          {
            isVi
              ? "Tập dữ liệu tách biệt kịch bản (6.7121:1 trên Train)."
              : "Scenario-disjoint flow record (6.7121:1 Train ratio)."
          }
        </h2><p class="lede">
          {
            isVi
              ? "Tập dữ liệu AIT-NDS-v2 đã xác minh gồm 3,464,400 dòng có nhãn: 2,845,522 flow Benign (82.1%) và 618,878 flow Attack (17.9%), ngoài ra có 942 dòng unmapped ở kịch bản shaw bị loại trừ rõ ràng khỏi split."
              : "The verified AIT-NDS-v2 corpus contains 3,464,400 labeled rows: 2,845,522 benign flows (82.1%) and 618,878 attack flows (17.9%), plus 942 unmapped rows in scenario shaw explicitly excluded from the split."
          }
        </p><div
          class="distribution"
          role="img"
          aria-label={isVi
            ? "Phân bố dữ liệu: 82.1 phần trăm Benign và 17.9 phần trăm Attack"
            : "Dataset distribution: 82.1 percent benign and 17.9 percent attack"}
        >
          <span style="width:82.1%"></span><span style="width:17.9%"></span>
        </div><div class="legend">
          <span>● Benign · 2,845,522 (82.1%)</span><span
            >● Attack · 618,878 (17.9%)</span
          >
        </div><p class="note">
          {
            isVi
              ? "Giao thức v2-scenario-group-purged-v1 bảo đảm 0 chồng lấn kịch bản và 0 chồng lấn 5-tuple+timestamp giữa Train (fox, harrison, santos, wardbeck, wilson), Validation (russellmitchell) và Test (shaw, wheeler). "
              : "Protocol v2-scenario-group-purged-v1 enforces 0 scenario overlap and 0 5-tuple+timestamp overlap across Train (fox, harrison, santos, wardbeck, wilson), Validation (russellmitchell) and Test (shaw, wheeler). "
          }<a href={source("data/V2_SPLIT_MANIFEST.json")}
            >{
              isVi
                ? "Xem V2_SPLIT_MANIFEST.json ↗"
                : "Inspect V2_SPLIT_MANIFEST.json ↗"
            }</a
          >
        </p>
      </div><div class="surface category-panel">
        <h3>
          {
            isVi
              ? "Năm họ tấn công chuẩn hóa (AIT-NDS-v2)"
              : "Five canonical attack categories (AIT-NDS-v2)"
          }
        </h3><div class="table-wrap">
          <table class="data-table">
            <caption class="sr-only"
              >{
                isVi
                  ? "Số lượng dòng theo từng họ tấn công trong AIT-NDS-v2"
                  : "Attack category counts in AIT-NDS-v2"
              }</caption
            ><thead
              ><tr
                ><th scope="col">{isVi ? "Họ tấn công" : "Category"}</th><th
                  scope="col">{isVi ? "Số dòng" : "Rows"}</th
                ></tr
              ></thead
            ><tbody
              >{
                categories.map(([name, count]) => (
                  <tr>
                    <>
                      <th scope="row">{name}</th>
                      <td>{count}</td>
                    </>
                  </tr>
                ))
              }</tbody
            >
          </table>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <span class="eyebrow"
        >{
          isVi
            ? "Hợp đồng dữ liệu · canonical-flow-v2-18"
            : "Data contract · canonical-flow-v2-18"
        }</span
      ><h2>
        {
          isVi
            ? "32 cột chuẩn hóa, không nội suy đặc trưng thiếu."
            : "32 canonical columns, strict anti-imputation."
        }
      </h2><div class="schema-grid">
        <div class="surface">
          <span class="schema-num">18</span><h3>
            {isVi ? "Đặc trưng ML (6 + 12)" : "ML features (6 + 12)"}
          </h3><p>
            {
              isVi
                ? "6 đặc trưng quan sát cơ sở (duration_ms, bytes/pkts hai chiều, protocol) và 12 đặc trưng dẫn xuất tất định (tổng, tỷ lệ, tốc độ, byte/pkt, has_response, is_unidirectional). Loại bỏ hoàn toàn TTL/TCP window phòng lab."
                : "6 base observed fields (duration_ms, bidirectional bytes/pkts, protocol) plus 12 deterministic derived ratios, rates and flags. Lab-specific TTL and TCP window shortcuts are excluded."
            }
          </p>
        </div><div class="surface">
          <span class="schema-num">10</span><h3>
            {
              isVi
                ? "Truy vết (5) & Provenance (5)"
                : "Trace (5) & Provenance (5)"
            }
          </h3><p>
            {
              isVi
                ? "5 cột metadata truy vết (timestamp, src/dst IP, src/dst port) và 5 cột provenance (source_dataset, scenario_id, source_flow_id...) giữ riêng cho OOD gate và BehavioralVector, loại khỏi ma trận "
                : "5 trace metadata columns (timestamps, src/dst IP, src/dst port) and 5 provenance columns (source_dataset, scenario_id, source_flow_id...) are retained for OOD gating and BehavioralVector, excluded from "
            }<code>X</code>.
          </p>
        </div><div class="surface">
          <span class="schema-num">04</span><h3>
            {isVi ? "Nhãn phân cấp" : "Hierarchical labels"}
          </h3><p>
            {
              isVi
                ? "4 cột nhãn (nhị phân, họ tấn công chuẩn hóa 5 lớp, nhãn gốc và cờ đánh giá) được tách biệt hoàn toàn khỏi đầu vào suy luận."
                : "4 label columns (binary label, 5-class canonical taxonomy, raw source label and evaluation metadata) are strictly separated from model inputs."
            }
          </p>
        </div>
      </div><p class="source-line">
        {
          isVi
            ? "Chính sách chống nội suy: nguồn thiếu bất kỳ đặc trưng nào trong 6 trường cơ sở sẽ bị đánh dấu FEATURE_INCOMPATIBLE và chặn suy luận ML."
            : "Anti-imputation policy: any source missing required base observations is flagged FEATURE_INCOMPATIBLE and blocked from ML inference."
        }
      </p><p class="source-line">
        {isVi ? "Nguồn: " : "Source: "}<a
          href={source("src/network_anomaly/data/v2_schema.py")}
          >{isVi ? "lược đồ v2_schema.py ↗" : "v2_schema.py contract ↗"}</a
        > · <a href={source("src/network_anomaly/data/taxonomy.py")}
          >{isVi ? "phân loại taxonomy.py ↗" : "taxonomy.py mapping ↗"}</a
        > · <a href={source("docs/FEATURE_COMPATIBILITY_MATRIX.md")}
          >{
            isVi
              ? "ma trận tương thích đặc trưng ↗"
              : "feature compatibility matrix ↗"
          }</a
        >
      </p>
    </div>
  </section>
  <section class="section rule tinted">
    <div class="container two-column">
      <div>
        <span class="eyebrow"
          >{
            isVi
              ? "Hard Cutover & Kiểm định liên kết"
              : "Hard Cutover & linkage audit"
          }</span
        ><h2>
          {
            isVi
              ? "Cách ly v1 và chứng minh giới hạn liên kết log."
              : "Retiring v1 and proving log-linkage limits."
          }
        </h2><p>
          {
            isVi
              ? "Gói v1 (NF-UNSW-NB15-v3, UQ 454104) đã được chuyển hẳn sang historical/nf_unsw_nb15_v3/ với chế độ từ chối fail-closed (0 fallback v1). Kiểm toán #85 trên 1,882,973 sự kiện log hệ thống của AIT-LDS-v2.1 (fox, russellmitchell) chứng minh DIRECT_UID_LINK = FALSE và tỷ lệ nhập nhằng đa luồng lên tới 72.87–87.91%."
              : "Legacy v1 (NF-UNSW-NB15-v3, UQ 454104) is retired to historical/nf_unsw_nb15_v3/ with fail-closed rejection and zero v1 fallback. Audit #85 across 1,882,973 system log events in AIT-LDS-v2.1 (fox, russellmitchell) proved DIRECT_UID_LINK = FALSE with 72.87–87.91% multi-flow ambiguity."
          }
        </p><div class="callout">
          {
            isVi
              ? "AIT-LDS-v2.1 (DOI 10.5281/zenodo.19483937, CC BY-NC-SA 4.0) được cách ly trong thư mục .gitignored: 0% rò rỉ vào trọng số ML hay demo_flows.csv."
              : "AIT-LDS-v2.1 (DOI 10.5281/zenodo.19483937, CC BY-NC-SA 4.0) is isolated in .gitignored storage with 0% leakage into ML weights or demo_flows.csv."
          }
        </div><p class="source-line">
          <a href={source("docs/adr/ADR-dataset-hard-cutover-v2.md")}
            >{isVi ? "ADR Hard Cutover v2 ↗" : "ADR Hard Cutover v2 ↗"}</a
          > · <a href={source("docs/dataset/AIT_LINKAGE_FEASIBILITY.md")}
            >{
              isVi
                ? "Báo cáo khả thi liên kết #85 ↗"
                : "Linkage feasibility audit #85 ↗"
            }</a
          >
        </p>
      </div><div>
        <span class="eyebrow"
          >{isVi ? "Chia tập & tiền xử lý" : "Split and preprocessing"}</span
        ><h2>
          {
            isVi
              ? "TrainOnlyPreprocessor(asinh_robust)."
              : "TrainOnlyPreprocessor(asinh_robust)."
          }
        </h2><ol class="steps">
          <li>
            <strong>{isVi ? "Tách kịch bản" : "Scenario split"}</strong><span
              >{
                isVi
                  ? "Train: 2,097,891 (fox, harrison, santos, wardbeck, wilson); Val: 377,704 (russellmitchell); Test: 988,805 (shaw, wheeler)."
                  : "Train: 2,097,891 (fox, harrison, santos, wardbeck, wilson); Val: 377,704 (russellmitchell); Test: 988,805 (shaw, wheeler)."
              }</span
            >
          </li><li>
            <strong>{isVi ? "Chống rò rỉ" : "Zero overlap"}</strong><span
              >{
                isVi
                  ? "0 kịch bản trùng và 0 cặp 5-tuple+timestamp trùng giữa các phân vùng; 942 dòng shaw unmapped bị loại trừ."
                  : "0 overlapping scenarios and 0 overlapping 5-tuple+timestamp records across partitions; 942 unmapped shaw rows excluded."
              }</span
            >
          </li><li>
            <strong>{isVi ? "Biến đổi" : "Transform"}</strong><span
              >{
                isVi
                  ? "Biến đổi asinh kết hợp chuẩn hóa robust chỉ fit trên Train với sàn tỷ lệ MIN_BOUNDED_SCALE_FLOOR = 0.25 chống nổ gradient."
                  : "Train-only asinh + robust scaling with MIN_BOUNDED_SCALE_FLOOR = 0.25 to prevent near-zero IQR explosion."
              }</span
            >
          </li><li>
            <strong>{isVi ? "Cổng OOD" : "OOD gate"}</strong><span
              >{
                isVi
                  ? "Xác minh SHA-256 của cổng OOD (NETFLOW_OOD_GATE_SHA256) ở chế độ deployment trước khi cho phép suy luận."
                  : "Enforce trusted NETFLOW_OOD_GATE_SHA256 verification in deployment mode before model inference."
              }</span
            >
          </li>
        </ol><p class="source-line">
          <a href={source("src/network_anomaly/preprocessing/pipeline.py")}
            >{isVi ? "Mã pipeline tiền xử lý ↗" : "Preprocessing pipeline ↗"}</a
          > · <a
            href={source(
              "reports/datasets/ait_timestamp_alignment_report.json",
            )}
            >{
              isVi
                ? "Báo cáo căn chỉnh timestamp ↗"
                : "Timestamp alignment report ↗"
            }</a
          >
        </p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container two-column">
      <div>
        <span class="eyebrow"
          >{
            isVi
              ? "Đa nguồn ngoại vi & Tái lập"
              : "External corpora & reproducibility"
          }</span
        ><h2>
          {
            isVi
              ? "CTU-SME-11, UWF-ZeekData24 & UGR'16."
              : "CTU-SME-11, UWF-ZeekData24 & UGR'16."
          }
        </h2><p>
          {
            isVi
              ? "Đánh giá dịch chuyển miền sử dụng CTU-SME-11 (DOI 10.5281/zenodo.7958258, CC BY 4.0, 251,219 flow Zeek SME thật: CTU-Echo 76,073 và CTU-Win7AD 175,146 + 9,394 unmapped) cùng UWF-ZeekData24 (evaluation_only = true, 95,871 flow có nhãn / 93,000 strict complete). UGR'16 giữ trạng thái BLOCKED do máy chủ nhà xuất bản trả về HTTP 403 (Portal en Mantenimiento)."
              : "Domain-shift evaluation uses CTU-SME-11 (DOI 10.5281/zenodo.7958258, CC BY 4.0, 251,219 real SME Zeek flows: CTU-Echo 76,073 and CTU-Win7AD 175,146 + 9,394 unmapped) and UWF-ZeekData24 (evaluation_only = true, 95,871 labeled flows / 93,000 strict complete). UGR'16 remains BLOCKED due to upstream HTTP 403 (Portal en Mantenimiento)."
          }
        </p><a
          class="button"
          href={source("reports/datasets/v2_multi_source_profile.json")}
          >{
            isVi
              ? "Hồ sơ đa nguồn v2_multi_source_profile.json ↗"
              : "Multi-source profile JSON ↗"
          }</a
        >
      </div><div class="surface license-note">
        <h3>
          {
            isVi
              ? "Bản quyền, giấy phép & kiểm soát phân phối"
              : "Attribution, licensing & distribution control"
          }
        </h3><p>
          {
            isVi
              ? "Mã nguồn phát hành theo giấy phép Apache-2.0 (kèm NOTICE và THIRD_PARTY_NOTICES.md). AIT-NDS-v2 và CTU-SME-11 có giấy phép CC BY 4.0; UWF-ZeekData24 bị khóa evaluation_only = true; AIT-LDS-v2.1 (CC BY-NC-SA 4.0) cách ly ngoài bản phân phối. Phân phối nhị phân công khai hiện bị khóa ở "
              : "Source code is licensed under Apache-2.0 (with NOTICE and THIRD_PARTY_NOTICES.md). AIT-NDS-v2 and CTU-SME-11 are CC BY 4.0; UWF-ZeekData24 is locked as evaluation_only = true; AIT-LDS-v2.1 (CC BY-NC-SA 4.0) is isolated outside distribution. Public binary release remains locked at "
          }<code>approved = false</code>{" "}
          {isVi ? "trong " : "in "}<a
            href={source("reports/governance/DISTRIBUTION_AUTHORIZATION.json")}
            ><code>DISTRIBUTION_AUTHORIZATION.json</code> ↗</a
          >.
        </p><a href={source("data/EXTERNAL_DATASETS_PROVENANCE.json")}
          >{
            isVi
              ? "Hồ sơ provenance ngoại vi ↗"
              : "External datasets provenance ↗"
          }</a
        > · <a href={source("reports/audits/V2_UGR16_ALTERNATIVES_REVIEW.md")}
          >{
            isVi ? "Đánh giá thay thế UGR'16 ↗" : "UGR'16 alternatives review ↗"
          }</a
        >
      </div>
    </div>
  </section>
</Layout>
<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .facts > div {
    padding: 1rem;
    border-right: 1px solid var(--line);
  }
  .facts > div:first-child {
    padding-left: 0;
  }
  .facts > div:last-child {
    border: 0;
  }
  .facts small,
  .facts strong {
    display: block;
  }
  .facts small {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 0.5rem;
  }
  .facts strong {
    font-size: 0.92rem;
  }
  .two-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
  }
  .two-column > *,
  .schema-grid > *,
  .facts > *,
  .steps li > * {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .category-panel .data-table th,
  .category-panel .data-table td {
    overflow-wrap: anywhere;
  }
  .two-column h2 {
    margin: 0.7rem 0 1rem;
  }
  .two-column p {
    color: var(--muted);
  }
  .distribution {
    display: flex;
    height: 20px;
    overflow: hidden;
    border-radius: 2px;
    margin: 2rem 0 0.6rem;
  }
  .distribution span:first-child {
    background: var(--cyan);
  }
  .distribution span:last-child {
    background: var(--violet);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.76rem;
  }
  .legend span:first-child {
    color: var(--cyan);
  }
  .legend span:last-child {
    color: var(--violet);
  }
  .note {
    font-size: 0.84rem;
    margin-top: 2rem;
  }
  .note a,
  .source-line a,
  .license-note a {
    color: var(--cyan);
  }
  .category-panel {
    padding: 1.5rem;
  }
  .category-panel h3 {
    margin: 0 0 1rem;
  }
  .category-panel .data-table {
    min-width: 0;
  }
  .category-panel td {
    text-align: right;
  }
  .schema-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 2rem 0;
  }
  .schema-grid > div {
    padding: 1.5rem;
  }
  .schema-num {
    font-size: 2.1rem;
    font-weight: 800;
    color: var(--cyan);
    letter-spacing: -0.05em;
  }
  .schema-grid h3 {
    margin: 0.8rem 0;
  }
  .schema-grid p {
    color: var(--muted);
    font-size: 0.88rem;
  }
  .source-line {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .tinted {
    background: var(--surface);
  }
  .steps {
    list-style: none;
    margin: 1.5rem 0;
    padding: 0;
  }
  .steps li {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 1rem;
    border-top: 1px solid var(--line);
    padding: 1rem 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .steps strong {
    color: var(--cyan);
  }
  .license-note {
    padding: 1.5rem;
    align-self: start;
  }
  .license-note h3 {
    margin-top: 0;
  }
  .license-note p {
    color: var(--muted);
  }
  @media (max-width: 800px) {
    .facts,
    .schema-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .two-column {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
  @media (max-width: 550px) {
    .facts,
    .schema-grid {
      grid-template-columns: 1fr;
    }
    .facts > div {
      padding: 1rem 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .facts > div:last-child {
      border: 0;
    }
  }
</style>
