---
import Layout from "../../layouts/Layout.astro";
import PageIntro from "../../components/PageIntro.astro";
import { source, type Lang } from "../../lib/links";

interface Props {
  lang?: Lang;
}
const { lang = "vi" } = Astro.props;
const isVi = lang === "vi";

const layers = isVi
  ? [
      [
        "Tải & kiểm định dữ liệu",
        "Đã kiểm thử & xác minh",
        "Script tải nguồn chính thức, manifest, kiểm định chất lượng streaming, EDA và tách demo chỉ từ Validation đã có trên main.",
        source("docs/dataset/NF_UNSW_NB15_V3_PROVENANCE.md"),
      ],
      [
        "Chia tập, tiền xử lý & cổng OOD",
        "Đã triển khai & kiểm thử",
        "Split theo thời gian, TrainOnlyPreprocessor, đánh giá tương thích 4 tầng, xác minh provenance và từ chối ABSTAINED_OOD.",
        source("docs/MULTI_SOURCE_INGESTION.md"),
      ],
      [
        "Bốn mô hình ML đã kiểm chứng",
        "Đã đánh giá Held-out Test",
        "Random Forest, XGBoost, Isolation Forest và Autoencoder đều đã đánh giá Train/Val/Test; file .joblib giữ ngoài Git.",
        source("reports/evaluation/error_analysis_report.md"),
      ],
      [
        "Thống kê hành vi, rủi ro & timeline",
        "Đã triển khai (phạm vi M6)",
        "Thống kê metadata NetFlow (#28), chấm điểm ưu tiên tất định 0–100 (#32) và timeline tất định (#24); không dùng log Auth/API.",
        source("docs/ARCHITECTURE.md"),
      ],
      [
        "Phản ứng thích ứng Dry-Run (#27)",
        "Đã triển khai (Dry-Run)",
        "Policy engine tất định và mô phỏng xoay khóa (executed=false) gắn với phân tích xác minh trên server; firewall thật & AES keyring hoãn.",
        source("reports/api/API_CONTRACT.md"),
      ],
      [
        "FastAPI (127.0.0.1) & SQLite",
        "Đã triển khai & kiểm thử",
        "18 endpoint REST cục bộ, token phiên 256-bit X-Sentinel-Session-Token, SQLite đơn chủ ghi và xuất metadata SHA-256.",
        source("reports/api/openapi.json"),
      ],
      [
        "Desktop UI (Tauri 2 + Svelte 5)",
        "Đã triển khai (v1.0.0 Source)",
        "Bộ cài Windows x64 NSIS nhúng PyInstaller FastAPI Sidecar, 4 .joblib và demo_flows.csv lúc build; máy người dùng cuối không cần Python/venv. Bộ cài công khai đang chờ Issue #73.",
        source("docs/WINDOWS_INSTALLATION.md"),
      ],
      [
        "Chặn OS thật & phân phối nhị phân",
        "Đang hoãn / Chờ (#73)",
        "Tự động hóa firewall hệ điều hành, xoay khóa AES-256-GCM trong OS keyring (#26/#27), bắt gói PCAP trực tiếp đang hoãn; phát hành .exe công khai chờ Clean VM E2E & rà soát UQ 454104 (#73).",
        source("docs/releases/v1.0.0.md"),
      ],
    ]
  : [
      [
        "Data acquisition & validation",
        "Tested & verified",
        "Official-source fetcher, manifest, streaming quality checks, EDA and Validation-only demo prep are on main.",
        source("docs/dataset/NF_UNSW_NB15_V3_PROVENANCE.md"),
      ],
      [
        "Split, preprocessing & OOD gate",
        "Implemented & tested",
        "Chronological split, TrainOnlyPreprocessor, 4-tier compatibility evaluator, provenance trust anchor and ABSTAINED_OOD gate.",
        source("docs/MULTI_SOURCE_INGESTION.md"),
      ],
      [
        "Four verified ML models",
        "Held-out Test verified",
        "Random Forest, XGBoost, Isolation Forest and Autoencoder all evaluated on Train/Val/Test; .joblib binaries stay outside Git.",
        source("reports/evaluation/error_analysis_report.md"),
      ],
      [
        "Behavioral, risk & timeline",
        "Implemented (scoped M6)",
        "NetFlow metadata stats (#28), deterministic 0–100 priority (#32) and deterministic timeline (#24); no Auth/API logs.",
        source("docs/ARCHITECTURE.md"),
      ],
      [
        "Adaptive response dry-run (#27)",
        "Implemented (Dry-Run)",
        "Deterministic policy engine and rotation simulation (executed=false) gated on server-verified analysis; live OS firewall & AES keyring deferred.",
        source("reports/api/API_CONTRACT.md"),
      ],
      [
        "FastAPI (127.0.0.1) & SQLite",
        "Implemented & tested",
        "18 localhost REST endpoints, 256-bit X-Sentinel-Session-Token auth, single-writer SQLite persistence and SHA-256 export metadata.",
        source("reports/api/openapi.json"),
      ],
      [
        "Desktop UI (Tauri 2 + Svelte 5)",
        "Implemented (v1.0.0 Source)",
        "Windows x64 NSIS installer embeds PyInstaller FastAPI Sidecar, 4 .joblib models and demo_flows.csv at build time; zero end-user Python/venv. Public installer awaits Issue #73.",
        source("docs/WINDOWS_INSTALLATION.md"),
      ],
      [
        "Live OS blocking & public installer",
        "Deferred / Blocked (#73)",
        "Live firewall automation, AES-256-GCM OS keyring rotation (#26/#27) and live PCAP remain deferred; public .exe binary awaits Clean VM E2E & UQ 454104 review (#73).",
        source("docs/releases/v1.0.0.md"),
      ],
    ];
---

<Layout
  title={isVi ? "Kiến trúc hệ thống" : "System Architecture"}
  description={isVi
    ? "Kiến trúc NetFlow Sentinel v1.0.0 (Tauri 2 + Svelte 5 -> PyInstaller FastAPI Sidecar -> SQLite + 4 ML Models)."
    : "NetFlow Sentinel v1.0.0 architecture (Tauri 2 + Svelte 5 -> PyInstaller FastAPI Sidecar -> SQLite + 4 ML Models)."}
  section="Architecture"
  lang={lang}
  routePath="architecture/"
>
  <PageIntro
    eyebrow={isVi ? "05 / Kiến trúc" : "05 / Architecture"}
    current={isVi ? "Kiến trúc" : "Architecture"}
    title={isVi
      ? "Hệ thống desktop standalone với ranh giới rõ ràng."
      : "A standalone desktop architecture with explicit boundaries."}
    description={isVi
      ? "Kiến trúc v1.0.0 kết nối giao diện Tauri 2 + Svelte 5 với PyInstaller FastAPI Sidecar nhúng 4 mô hình, SQLite cục bộ và cổng từ chối OOD. Khối nét liền đã có trên main; khối nét đứt đang hoãn hoặc chờ nghiệm thu (#73)."
      : "The v1.0.0 architecture connects Tauri 2 + Svelte 5 with a build-time embedded PyInstaller FastAPI Sidecar, SQLite persistence, OOD gating and 4 validated ML models. Solid nodes are implemented on main; dashed nodes are deferred or awaiting #73."}
    lang={lang}
  />
  <section class="section">
    <div class="container">
      <div class="diagram-head">
        <div>
          <span class="eyebrow"
            >{
              isVi
                ? "NetFlow Sentinel v1.0.0 (Standalone Sidecar)"
                : "NetFlow Sentinel v1.0.0 (Standalone Sidecar)"
            }</span
          ><h2>
            {
              isVi
                ? "Từ bản ghi flow tới bằng chứng trên desktop."
                : "From flow record to desktop evidence trail."
            }
          </h2>
        </div><div class="diagram-legend">
          <span><i></i> {isVi ? "Trên main" : "Implemented on main"}</span><span
            ><i></i> {isVi ? "Hoãn / ngoài gói" : "Deferred / external"}</span
          >
        </div>
      </div><div class="diagram-wrap surface">
        <svg
          role="img"
          aria-labelledby="diagram-title diagram-desc"
          viewBox="0 0 1040 530"
          xmlns="http://www.w3.org/2000/svg"
          ><title id="diagram-title">
            {
              isVi
                ? "Kiến trúc desktop phát hiện bất thường mạng hợp nhất"
                : "Consolidated network anomaly detection desktop architecture"
            }
          </title><desc id="diagram-desc"
            >{
              isVi
                ? "Tải dữ liệu và cổng OOD nối vào tiền xử lý train-only, bốn mô hình, thống kê hành vi, rủi ro và timeline, mô phỏng dry-run, FastAPI/SQLite trong PyInstaller Sidecar và ứng dụng Tauri 2 + Svelte 5. Chặn firewall thật, AES keyring và phân phối nhị phân công khai (#73) nằm ở nhánh hoãn."
                : "Verified NetFlow acquisition and OOD gating feed train-only preprocessing, four validated models, NetFlow behavioral summary, deterministic risk/timeline, dry-run simulation, the bundled PyInstaller FastAPI/SQLite Sidecar and the Tauri 2 + Svelte 5 desktop app. Live firewall/AES-256-GCM keyring and public #73 installer release remain deferred."
            }</desc
          ><defs
            ><marker
              id="arrow"
              markerWidth="8"
              markerHeight="8"
              refX="7"
              refY="4"
              orient="auto"
              ><path d="M0 0 L8 4 L0 8" fill="#66e1e8"></path></marker
            ><marker
              id="arrow-muted"
              markerWidth="8"
              markerHeight="8"
              refX="7"
              refY="4"
              orient="auto"
              ><path d="M0 0 L8 4 L0 8" fill="#778ca0"></path></marker
            ></defs
          >
          <g
            fill="none"
            stroke="#66e1e8"
            stroke-width="2"
            marker-end="url(#arrow)"
            ><path d="M235 100H305"></path><path d="M495 100H565"></path><path
              d="M755 100H825"></path><path d="M920 145V230"></path><path
              d="M825 272H755"></path><path d="M565 272H495"></path><path
              d="M305 272H235"></path><path d="M130 315V390"></path><path
              d="M235 435H305"></path></g
          >
          <g
            fill="none"
            stroke="#778ca0"
            stroke-width="2"
            stroke-dasharray="5 5"
            marker-end="url(#arrow-muted)"
            ><path d="M400 315V352H685V390"></path></g
          >
          <g fill="#132b3d" stroke="#66e1e8" stroke-width="2"
            ><rect x="25" y="55" width="210" height="90" rx="5"></rect><rect
              x="305"
              y="55"
              width="190"
              height="90"
              rx="5"></rect><rect x="565" y="55" width="190" height="90" rx="5"
            ></rect><rect x="825" y="55" width="190" height="90" rx="5"
            ></rect><rect x="825" y="230" width="190" height="85" rx="5"
            ></rect><rect x="565" y="230" width="190" height="85" rx="5"
            ></rect><rect x="305" y="230" width="190" height="85" rx="5"
            ></rect><rect x="25" y="230" width="210" height="85" rx="5"
            ></rect><rect x="25" y="390" width="210" height="90" rx="5"
            ></rect><rect x="305" y="390" width="230" height="90" rx="5"
            ></rect></g
          >
          <g
            fill="#152334"
            stroke="#778ca0"
            stroke-width="2"
            stroke-dasharray="7 6"
            ><rect x="565" y="390" width="240" height="90" rx="5"></rect></g
          >
          <g
            font-family="ui-sans-serif,system-ui"
            fill="#e8f6f8"
            font-size="16"
            font-weight="700"
            ><text x="43" y="91"
              >{isVi ? "Tải + cổng OOD" : "Acquire + OOD gate"}</text
            ><text x="323" y="91">{isVi ? "Tiền xử lý" : "Preprocess"}</text
            ><text x="583" y="91">RF / XGBoost</text><text x="843" y="91"
              >IF / Autoencoder</text
            ><text x="843" y="264"
              >{isVi ? "Thống kê (#28)" : "Behavioral (#28)"}</text
            ><text x="583" y="264"
              >{isVi ? "Rủi ro + Timeline" : "Risk + Timeline"}</text
            ><text x="323" y="264"
              >{isVi ? "Mô phỏng (#27)" : "Dry-Run (#27)"}</text
            ><text x="43" y="264">FastAPI + SQLite</text><text x="43" y="425"
              >Tauri 2 + Svelte 5</text
            ><text x="323" y="425"
              >{isVi ? "Sidecar PyInstaller" : "PyInstaller Sidecar"}</text
            ><text x="583" y="425"
              >{isVi ? "Hoãn & Chờ (#73)" : "Deferred / #73"}</text
            ></g
          >
          <g font-family="ui-sans-serif,system-ui" fill="#9fb3c4" font-size="12"
            ><text x="43" y="119">provenance & ABSTAINED_OOD</text><text
              x="323"
              y="119">train-only SHA-256</text
            ><text x="583" y="119">Test F1 0.9999 / 1.0000</text><text
              x="843"
              y="119">Test F1 0.5064 / 0.1361</text
            ><text x="843" y="290">NetFlow metadata stats</text><text
              x="583"
              y="290">#32 & #24 deterministic</text
            ><text x="323" y="290">executed = false</text><text x="43" y="290"
              >127.0.0.1 + token auth</text
            ><text x="43" y="452">Windows NSIS v1.0.0</text><text
              x="323"
              y="452">Embedded 4 .joblib + demo CSV</text
            ><text x="583" y="452">firewall, keyring & public .exe</text></g
          ></svg
        >
      </div><p class="diagram-note">
        {
          isVi
            ? "NF-UNSW-NB15-v3 chỉ chứa trường NetFlow, không có log API, xác thực hay phiên ứng dụng. Thống kê hành vi (#28) chỉ dùng metadata NetFlow kèm thông báo không quy kết danh tính."
            : "NF-UNSW-NB15-v3 contains NetFlow fields, not API, authentication or application-session events. Behavioral summaries (#28) use NetFlow metadata only and include an explicit non-attribution notice."
        }
      </p>
    </div>
  </section>
  <section class="section rule tinted">
    <div class="container">
      <span class="eyebrow"
        >{isVi ? "Kiểm kê các tầng" : "Implementation inventory"}</span
      ><h2>
        {
          isVi
            ? "Trạng thái thực tế của từng tầng hệ thống."
            : "What each layer can claim today."
        }
      </h2><div class="table-wrap">
        <table class="data-table">
          <caption class="sr-only"
            >{
              isVi
                ? "Các tầng kiến trúc, trạng thái hiện tại và bằng chứng nguồn"
                : "Architecture layers, implementation status and evidence"
            }</caption
          ><thead
            ><tr
              ><th scope="col">{isVi ? "Tầng" : "Layer"}</th><th scope="col"
                >{isVi ? "Trạng thái" : "Current status"}</th
              ><th scope="col"
                >{isVi ? "Ranh giới bằng chứng" : "Evidence boundary"}</th
              ><th scope="col">{isVi ? "Nguồn" : "Source"}</th></tr
            ></thead
          ><tbody
            >{
              layers.map(([name, status, note, link]) => (
                <tr>
                  <>
                    <th scope="row">{name}</th>
                    <td>{status}</td>
                    <td>{note}</td>
                    <td>
                      <a href={link}>{isVi ? "Xem ↗" : "Inspect ↗"}</a>
                    </td>
                  </>
                </tr>
              ))
            }</tbody
          >
        </table>
      </div>
    </div>
  </section>
</Layout>
<style>
  .diagram-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }
  .diagram-head h2 {
    margin: 0.6rem 0 1.5rem;
  }
  .diagram-legend {
    display: flex;
    gap: 1.4rem;
    color: var(--muted);
    font-size: 0.78rem;
    margin-bottom: 1.5rem;
  }
  .diagram-legend span {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    white-space: nowrap;
  }
  .diagram-legend i {
    display: block;
    width: 12px;
    height: 12px;
    border: 2px solid var(--cyan);
  }
  .diagram-legend span:last-child i {
    border-color: var(--muted);
    border-style: dashed;
  }
  .diagram-wrap {
    overflow: auto;
    padding: 1.5rem;
    background: #0b1929;
  }
  .diagram-wrap svg {
    display: block;
    min-width: 700px;
    width: 100%;
    height: auto;
  }
  .diagram-note {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .tinted {
    background: var(--surface);
  }
  .data-table a {
    color: var(--cyan);
  }
  .data-table td {
    color: var(--muted);
  }
  @media (max-width: 700px) {
    .diagram-head {
      display: block;
    }
    .diagram-legend {
      flex-wrap: wrap;
    }
  }
</style>
