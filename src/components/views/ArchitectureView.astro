---
import Layout from "../../layouts/Layout.astro";
import PageIntro from "../../components/PageIntro.astro";
import { source, type Lang } from "../../lib/links";

interface Props {
  lang?: Lang;
}
const { lang = "vi" } = Astro.props;
const isVi = lang === "vi";

const layers = isVi
  ? [
      [
        "Đa nguồn v2 & Hard Cutover",
        "Đã kiểm thử & xác minh",
        "AIT-NDS-v2 (3,464,400 dòng + 942 loại trừ), CTU-SME-11 (251,219 dòng) và UWF-ZeekData24 (95,871 dòng, evaluation_only=true); v1 chuyển hẳn vào historical/ (0 fallback).",
        source("docs/adr/ADR-dataset-hard-cutover-v2.md"),
      ],
      [
        "canonical-flow-v2-18 & cổng OOD",
        "Đã triển khai & kiểm thử",
        "18 đặc trưng ML (6 cơ sở + 12 dẫn xuất), chống nội suy FEATURE_INCOMPATIBLE, TrainOnlyPreprocessor(asinh_robust, floor 0.25) và cổng NETFLOW_OOD_GATE_SHA256.",
        source("docs/MULTI_SOURCE_INGESTION.md"),
      ],
      [
        "4 mô hình E0, E1 đa miền & 6-class RF",
        "RESEARCH_ONLY · Đã kiểm chứng",
        "RF (F1=0.9950), XGBoost (0.9013), Autoencoder (0.5877) và IF (0.5842) trên ait_test (N=988,805), kèm E1 đa miền (CTU_Test F1=0.9564), Autoencoder_E3b và RF_multiclass (Macro-F1=0.7347).",
        source("reports/experiments/ml/model_comparison_report.json"),
      ],
      [
        "3 chế độ vận hành & netflow-rs",
        "Đã kiểm chứng lặp lại 2x",
        "(1) Offline CSV (data/demo/demo_flows.csv, 200 flows, 4/4 REAL_MODELS, OOD=FITTED), (2) Dataset Replay (ait_test.csv.gz, batch 32, 399.44 flow/s), (3) Live Lab Monitoring (127.0.0.1 UDP NetFlow v9/IPFIX + pure-Rust telemetry/netflow-rs/ + LiveLogTailer).",
        source("scripts/verify_clean_state_demo.py"),
      ],
      [
        "Vector hành vi 16-D (RQ3)",
        "Đã triển khai & kiểm chứng",
        "Hợp đồng canonical-behavioral-v2-16 trên cửa sổ trượt; simulation L2 cosine F1=0.5556 và UWF standardized cosine F1=0.7192 (> IP 0.6919); liên kết log AIT bị chặn (#85).",
        source("docs/BEHAVIORAL_ENGINE.md"),
      ],
      [
        "AES-256-GCM, DPAPI & Xoay khóa (RQ5/RQ6)",
        "Đã kiểm chứng benchmark",
        "AES-256-GCM đạt 72,177.2 ops/s (256B, P95 13.3 µs) với Windows DPAPI keystore; xoay khóa thích ứng (Risk >= 85.0) giảm 87.5% cửa sổ lộ khóa, ResponsePolicy khóa ở dry_run = True (executed = false).",
        source("src/network_anomaly/crypto/rotation.py"),
      ],
      [
        "FastAPI 0.1.0, SQLite & Desktop 2.0.0",
        "Đã triển khai (676 + 41 + 17 tests)",
        "Tauri 2 + Svelte 5 Desktop 2.0.0, FastAPI 0.1.0 (33 OpenAPI paths / 35 operations), SQLite single-writer, X-Sentinel-Session-Token và process_batch(32) đạt 386.37 flow/s.",
        source("reports/api/API_CONTRACT.md"),
      ],
      [
        "Hạng mục DEFERRED / BLOCKED",
        "Đang hoãn / Chặn",
        "Lab router/switch vật lý (#137, real_device_tested = false), bộ cài Windows NSIS + kiểm thử VM sạch Windows 10/11 (#148), UGR'16 (HTTP 403) và phát hành nhị phân công khai (#154, approved = false).",
        source("docs/audits/V2_RELEASE_READINESS.md"),
      ],
    ]
  : [
      [
        "Multi-source v2 & Hard Cutover",
        "Tested & verified",
        "AIT-NDS-v2 (3,464,400 rows + 942 excluded), CTU-SME-11 (251,219 rows) and UWF-ZeekData24 (95,871 rows, evaluation_only=true); v1 retired to historical/ (zero fallback).",
        source("docs/adr/ADR-dataset-hard-cutover-v2.md"),
      ],
      [
        "canonical-flow-v2-18 & OOD gate",
        "Implemented & tested",
        "18 ML features (6 base + 12 derived), anti-imputation FEATURE_INCOMPATIBLE, TrainOnlyPreprocessor(asinh_robust, floor 0.25) and NETFLOW_OOD_GATE_SHA256 verification.",
        source("docs/MULTI_SOURCE_INGESTION.md"),
      ],
      [
        "4 E0 models, multi-domain E1 & 6-class RF",
        "RESEARCH_ONLY · Validated",
        "RF (F1=0.9950), XGBoost (0.9013), Autoencoder (0.5877) and IF (0.5842) on ait_test (N=988,805), plus multi-domain E1 (CTU_Test F1=0.9564), Autoencoder_E3b and RF_multiclass (Macro-F1=0.7347).",
        source("reports/experiments/ml/model_comparison_report.json"),
      ],
      [
        "3 operation modes & netflow-rs",
        "2x clean-state verified",
        "(1) Offline CSV (data/demo/demo_flows.csv, 200 flows, 4/4 REAL_MODELS, OOD=FITTED), (2) Dataset Replay (ait_test.csv.gz, batch 32, 399.44 flow/s), (3) Live Lab Monitoring (127.0.0.1 UDP NetFlow v9/IPFIX + pure-Rust telemetry/netflow-rs/ + LiveLogTailer).",
        source("scripts/verify_clean_state_demo.py"),
      ],
      [
        "16-D BehavioralVector engine (RQ3)",
        "Implemented & validated",
        "canonical-behavioral-v2-16 sliding-window contract; simulation L2 cosine F1=0.5556 and UWF standardized cosine F1=0.7192 (> IP 0.6919); AIT empirical linkage BLOCKED (#85).",
        source("docs/BEHAVIORAL_ENGINE.md"),
      ],
      [
        "AES-256-GCM, DPAPI & Key Rotation (RQ5/RQ6)",
        "Benchmark validated",
        "AES-256-GCM reaches 72,177.2 ops/s (256B, P95 13.3 µs) with Windows DPAPI keystore; adaptive key rotation (Risk >= 85.0) cuts exposure window by 87.5%, ResponsePolicy locked at dry_run = True (executed = false).",
        source("src/network_anomaly/crypto/rotation.py"),
      ],
      [
        "FastAPI 0.1.0, SQLite & Desktop 2.0.0",
        "Implemented (676 + 41 + 17 tests)",
        "Tauri 2 + Svelte 5 Desktop 2.0.0, FastAPI 0.1.0 (33 OpenAPI paths / 35 operations), single-writer SQLite, X-Sentinel-Session-Token and process_batch(32) at 386.37 flow/s.",
        source("reports/api/API_CONTRACT.md"),
      ],
      [
        "DEFERRED / BLOCKED items",
        "Deferred / Blocked",
        "Physical router/switch lab (#137, real_device_tested = false), Windows NSIS Installer + Clean Windows 10/11 VM E2E (#148), UGR'16 (HTTP 403) and Public Binary Release (#154, approved = false).",
        source("docs/audits/V2_RELEASE_READINESS.md"),
      ],
    ];
---

<Layout
  title={isVi ? "Kiến trúc hệ thống" : "System Architecture"}
  description={isVi
    ? "Kiến trúc NetFlow Sentinel v2.0.0 (Tauri 2 + Svelte 5 + FastAPI + SQLite + netflow-rs), 3 chế độ vận hành và ranh giới từng tầng."
    : "NetFlow Sentinel v2.0.0 architecture (Tauri 2 + Svelte 5 + FastAPI + SQLite + netflow-rs), 3 operation modes and layer boundaries."}
  section="Architecture"
  lang={lang}
  routePath="architecture/"
>
  <PageIntro
    eyebrow={isVi ? "05 / Kiến trúc v2.0" : "05 / Architecture v2.0"}
    current={isVi ? "Kiến trúc" : "Architecture"}
    title={isVi
      ? "Ba chế độ vận hành. Mặc định fail-closed."
      : "Three operation modes. Fail-closed by default."}
    description={isVi
      ? "NetFlow Sentinel v2.0.0 kết nối 3 chế độ thu nhận (Offline CSV, Dataset Replay 399.44 flow/s, Live Lab UDP NetFlow qua netflow-rs) với hợp đồng canonical-flow-v2-18, 4 mô hình E0, vector hành vi 16-D, mật mã AES-256-GCM + DPAPI và giao diện Tauri 2 + Svelte 5."
      : "NetFlow Sentinel v2.0.0 connects three ingestion modes (Offline CSV, Dataset Replay at 399.44 flow/s, Live Lab UDP NetFlow via netflow-rs) to the canonical-flow-v2-18 contract, four E0 models, 16-D behavioral vectors, AES-256-GCM + DPAPI keystore and a Tauri 2 + Svelte 5 desktop UI."}
    lang={lang}
  />
  <section class="section">
    <div class="container">
      <div class="diagram-head">
        <div>
          <span class="eyebrow"
            >{
              isVi
                ? "NetFlow Sentinel v2.0.0 · Functional Prototype"
                : "NetFlow Sentinel v2.0.0 · Functional Prototype"
            }</span
          ><h2>
            {
              isVi
                ? "Từ 3 chế độ vận hành tới bằng chứng mật mã trên desktop."
                : "From three operation modes to cryptographically sealed desktop evidence."
            }
          </h2>
        </div><div class="diagram-legend">
          <span
            ><i></i> {isVi ? "Đã triển khai v2.0" : "Implemented in v2.0"}</span
          ><span
            ><i></i>
            {isVi ? "Hoãn / Chặn (Deferred)" : "Deferred / Blocked"}</span
          >
        </div>
      </div><div class="diagram-wrap surface">
        <svg
          role="img"
          aria-labelledby="diagram-title diagram-desc"
          viewBox="0 0 1040 530"
          xmlns="http://www.w3.org/2000/svg"
          ><title id="diagram-title">
            {
              isVi
                ? "Kiến trúc NetFlow Sentinel v2.0.0"
                : "NetFlow Sentinel v2.0.0 system architecture"
            }
          </title><desc id="diagram-desc"
            >{
              isVi
                ? "Ba chế độ vận hành (Offline CSV, Dataset Replay, Live UDP netflow-rs) đi qua cổng OOD và TrainOnlyPreprocessor(asinh_robust) tới 4 mô hình E0 và 6-class RF, vector hành vi 16-D, xoay khóa thích ứng AES-256-GCM + DPAPI (dry_run=True), FastAPI 0.1.0 + SQLite (33 paths / 35 ops) và Tauri 2 + Svelte 5 Desktop 2.0.0. Lab phần cứng vật lý (#137) và NSIS installer +發 hành nhị phân (#148/#154) nằm ở nhánh hoãn."
                : "Three operation modes (Offline CSV, Dataset Replay, Live UDP netflow-rs) feed the OOD gate and TrainOnlyPreprocessor(asinh_robust), four E0 models + 6-class RF, 16-D BehavioralVector engine, adaptive AES-256-GCM + DPAPI key rotation (dry_run=True), FastAPI 0.1.0 + SQLite (33 paths / 35 ops) and Tauri 2 + Svelte 5 Desktop 2.0.0. Physical router lab (#137) and NSIS installer / public binary release (#148/#154) remain deferred."
            }</desc
          ><defs
            ><marker
              id="arrow"
              markerWidth="8"
              markerHeight="8"
              refX="7"
              refY="4"
              orient="auto"
              ><path d="M0 0 L8 4 L0 8" fill="#66e1e8"></path></marker
            ><marker
              id="arrow-muted"
              markerWidth="8"
              markerHeight="8"
              refX="7"
              refY="4"
              orient="auto"
              ><path d="M0 0 L8 4 L0 8" fill="#778ca0"></path></marker
            ></defs
          >
          <g
            fill="none"
            stroke="#66e1e8"
            stroke-width="2"
            marker-end="url(#arrow)"
            ><path d="M235 100H305"></path><path d="M495 100H565"></path><path
              d="M755 100H825"></path><path d="M920 145V230"></path><path
              d="M825 272H755"></path><path d="M565 272H495"></path><path
              d="M305 272H235"></path><path d="M130 315V390"></path></g
          >
          <g
            fill="none"
            stroke="#778ca0"
            stroke-width="2"
            stroke-dasharray="5 5"
            marker-end="url(#arrow-muted)"
            ><path d="M235 435H305"></path><path d="M400 315V352H685V390"
            ></path></g
          >
          <g fill="#132b3d" stroke="#66e1e8" stroke-width="2"
            ><rect x="25" y="55" width="210" height="90" rx="5"></rect><rect
              x="305"
              y="55"
              width="190"
              height="90"
              rx="5"></rect><rect x="565" y="55" width="190" height="90" rx="5"
            ></rect><rect x="825" y="55" width="190" height="90" rx="5"
            ></rect><rect x="825" y="230" width="190" height="85" rx="5"
            ></rect><rect x="565" y="230" width="190" height="85" rx="5"
            ></rect><rect x="305" y="230" width="190" height="85" rx="5"
            ></rect><rect x="25" y="230" width="210" height="85" rx="5"
            ></rect><rect x="25" y="390" width="210" height="90" rx="5"
            ></rect></g
          >
          <g
            fill="#152334"
            stroke="#778ca0"
            stroke-width="2"
            stroke-dasharray="7 6"
            ><rect x="305" y="390" width="230" height="90" rx="5"></rect><rect
              x="565"
              y="390"
              width="240"
              height="90"
              rx="5"></rect></g
          >
          <g
            font-family="ui-sans-serif,system-ui"
            fill="#e8f6f8"
            font-size="16"
            font-weight="700"
            ><text x="43" y="91"
              >{isVi ? "3 chế độ + OOD" : "3 Modes + OOD"}</text
            ><text x="323" y="91">{isVi ? "asinh_robust" : "asinh_robust"}</text
            ><text x="583" y="91">RF / XGBoost (E0)</text><text x="843" y="91"
              >IF / AE (E0 + E3b)</text
            ><text x="843" y="264"
              >{isVi ? "Hành vi 16-D (RQ3)" : "16-D Vector (RQ3)"}</text
            ><text x="583" y="264"
              >{isVi ? "Rủi ro & 6-class" : "Risk & 6-class"}</text
            ><text x="323" y="264"
              >{isVi ? "AES-GCM + DPAPI" : "AES-GCM + DPAPI"}</text
            ><text x="43" y="264">FastAPI + SQLite</text><text x="43" y="425"
              >Tauri 2 + Svelte 5</text
            ><text x="323" y="425"
              >{
                isVi ? "NSIS & Clean VM (#148)" : "NSIS & Clean VM (#148)"
              }</text
            ><text x="583" y="425"
              >{isVi ? "Lab vật lý & Binary" : "Physical Lab & Release"}</text
            ></g
          >
          <g font-family="ui-sans-serif,system-ui" fill="#9fb3c4" font-size="12"
            ><text x="43" y="119">CSV · Replay · netflow-rs</text><text
              x="323"
              y="119">18 features · floor 0.25</text
            ><text x="583" y="119">F1 0.9950 / 0.9013</text><text
              x="843"
              y="119">F1 0.5842 / 0.5877</text
            ><text x="843" y="290">UWF cosine F1 0.7192</text><text
              x="583"
              y="290">Macro-F1 0.7347 · batch 32</text
            ><text x="323" y="290">72.1k ops/s · dry_run=True</text><text
              x="43"
              y="290">33 paths / 35 ops · token</text
            ><text x="43" y="452">Desktop v2.0.0 · 2x clean</text><text
              x="323"
              y="452">deferred installer E2E</text
            ><text x="583" y="452">#137 & #154 approved=false</text></g
          ></svg
        >
      </div><p class="diagram-note">
        {
          isVi
            ? "Ba chế độ vận hành v2.0.0: (1) Offline CSV trên data/demo/demo_flows.csv (200 flows, 4/4 REAL_MODELS, OOD=FITTED, kiểm chứng lặp lại 2x qua scripts/verify_clean_state_demo.py), (2) Dataset Replay phát ait_test.csv.gz theo micro-batch 32 ở tốc độ 399.44 flow/s, và (3) Live Lab Monitoring qua 127.0.0.1 UDP NetFlow v9/IPFIX với collector pure-Rust telemetry/netflow-rs/ và LiveLogTailer."
            : "Three v2.0.0 operation modes: (1) Offline CSV on data/demo/demo_flows.csv (200 flows, 4/4 REAL_MODELS, OOD=FITTED, 2x repeatability verified via scripts/verify_clean_state_demo.py), (2) Dataset Replay streaming ait_test.csv.gz at micro-batch 32 and 399.44 flow/s, and (3) Live Lab Monitoring over 127.0.0.1 UDP NetFlow v9/IPFIX with the pure-Rust telemetry/netflow-rs/ collector and LiveLogTailer."
        }
      </p>
    </div>
  </section>
  <section class="section rule tinted">
    <div class="container">
      <span class="eyebrow"
        >{
          isVi ? "Kiểm kê các tầng v2.0" : "v2.0 implementation inventory"
        }</span
      ><h2>
        {
          isVi
            ? "Trạng thái thực tế của từng tầng hệ thống."
            : "What each layer can claim today."
        }
      </h2><div class="table-wrap">
        <table class="data-table">
          <caption class="sr-only"
            >{
              isVi
                ? "Các tầng kiến trúc v2.0, trạng thái hiện tại và bằng chứng nguồn"
                : "v2.0 architecture layers, implementation status and evidence"
            }</caption
          ><thead
            ><tr
              ><th scope="col">{isVi ? "Tầng" : "Layer"}</th><th scope="col"
                >{isVi ? "Trạng thái" : "Current status"}</th
              ><th scope="col"
                >{isVi ? "Ranh giới bằng chứng" : "Evidence boundary"}</th
              ><th scope="col">{isVi ? "Nguồn" : "Source"}</th></tr
            ></thead
          ><tbody
            >{
              layers.map(([name, status, note, link]) => (
                <tr>
                  <>
                    <th scope="row">{name}</th>
                    <td>{status}</td>
                    <td>{note}</td>
                    <td>
                      <a href={link}>{isVi ? "Xem ↗" : "Inspect ↗"}</a>
                    </td>
                  </>
                </tr>
              ))
            }</tbody
          >
        </table>
      </div>
    </div>
  </section>
</Layout>
<style>
  .diagram-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }
  .diagram-head h2 {
    margin: 0.6rem 0 1.5rem;
  }
  .diagram-legend {
    display: flex;
    gap: 1.4rem;
    color: var(--muted);
    font-size: 0.78rem;
    margin-bottom: 1.5rem;
  }
  .diagram-legend span {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    white-space: nowrap;
  }
  .diagram-legend i {
    display: block;
    width: 12px;
    height: 12px;
    border: 2px solid var(--cyan);
  }
  .diagram-legend span:last-child i {
    border-color: var(--muted);
    border-style: dashed;
  }
  .diagram-wrap {
    overflow: auto;
    padding: 1.5rem;
    background: #0b1929;
  }
  .diagram-wrap svg {
    display: block;
    min-width: 700px;
    width: 100%;
    height: auto;
  }
  .diagram-note {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .tinted {
    background: var(--surface);
  }
  .data-table a {
    color: var(--cyan);
  }
  .data-table td {
    color: var(--muted);
  }
  @media (max-width: 700px) {
    .diagram-head {
      display: block;
    }
    .diagram-legend {
      flex-wrap: wrap;
    }
  }
</style>
