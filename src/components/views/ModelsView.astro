---
import Layout from "../../layouts/Layout.astro";
import PageIntro from "../../components/PageIntro.astro";
import { source, type Lang } from "../../lib/links";

interface Props {
  lang?: Lang;
}
const { lang = "vi" } = Astro.props;
const isVi = lang === "vi";

const models = isVi
  ? [
      {
        id: "random-forest",
        index: "01",
        name: "Random Forest",
        type: "Supervised · baseline chính",
        status: "Đã đánh giá Held-out Test",
        statusClass: "validated",
        principle:
          "Tổ hợp nhiều cây quyết định bỏ phiếu nhãn nhị phân của flow, đóng vai trò điểm chuẩn giải thích được cho các so sánh sau.",
        role: "Phân loại Benign và Attack theo đúng hợp đồng 47 đặc trưng baseline.",
        input:
          "Đầu vào: 47 đặc trưng NetFlow theo thứ tự; loại trừ 2 nhãn và 6 trường metadata truy vết.",
        method:
          "Run chuẩn: 200 cây, max_depth=16, seed=42; huấn luyện trên Train (1.655.797 dòng), tiền xử lý train-only, kiểm định Validation và Held-out Test một lần.",
        evaluation:
          "Validation F1 0,999869; Held-out Test (rf-heldout-ea330b9, 345.953 dòng): F1 0,999853, Precision 0,999771, Recall 0,999935, FPR 0,000022 (TN=315.350, FP=7, FN=2, TP=30.594).",
        limit:
          "Phân tích độ quan trọng và cây 1 đặc trưng cho thấy đường tắt testbed (MIN_TTL + MAX_TTL chiếm 45,48%). Sụp đổ trên NF-CSE-CIC-IDS2018-v3 (Recall 0,0, FPR 0,3802). Tệp .joblib nằm ngoài Git.",
        link: source("reports/evaluation/error_analysis_report.md"),
      },
      {
        id: "xgboost",
        index: "02",
        name: "XGBoost",
        type: "Supervised · baseline đối chiếu",
        status: "Đã đánh giá Held-out Test",
        statusClass: "validated",
        principle:
          "Gradient-boosted trees xây dựng các cây tuần tự để giảm sai số phân loại trên dữ liệu flow có nhãn.",
        role: "Đối chiếu một mô hình supervised thứ hai với Random Forest trên cùng hợp đồng 47 đặc trưng và split.",
        input: "Đầu vào: cùng bộ 47 đặc trưng NetFlow với Random Forest.",
        method:
          "Run xgb-baseline-1794755807: XGBClassifier (binary:logistic), 200 cây, max_depth=6, learning_rate=0,1, subsample=0,8, colsample_bytree=0,8, tree_method=hist, seed=42.",
        evaluation:
          "Validation F1 0,999984; Held-out Test (345.953 dòng): F1 0,999984, Precision 0,999967, Recall 1,000000, FPR 0,000003, ROC-AUC 1,000000 (TN=315.356, FP=1, FN=0, TP=30.596).",
        limit:
          "Huấn luyện tại commit 7f51390 với git_dirty=True trước commit phát hành; tệp .joblib nằm ngoài Git (BLOCKED / NOT READY nếu thiếu). Chịu chung rủi ro shortcut TTL và trùng lặp vector.",
        link: source("reports/evaluation/xgboost/evaluation_report.md"),
      },
      {
        id: "isolation-forest",
        index: "03",
        name: "Isolation Forest",
        type: "Unsupervised · điểm bất thường",
        status: "Đã đánh giá Held-out Test",
        statusClass: "validated",
        principle:
          "Phân hoạch ngẫu nhiên cô lập các điểm dị biệt nhanh hơn; đường đi ngắn tạo ra điểm bất thường thô (raw_anomaly_score) cao hơn.",
        role: "Cung cấp bộ phát hiện bất thường huấn luyện hoàn toàn không dùng nhãn tấn công.",
        input:
          "Đầu vào: 1.590.608 flow lành tính (Benign) của tập Train sau biến đổi train-only.",
        method:
          "Run if-c4-20261115T055359Z (commit sạch bf0f3ec, 100 cây, contamination=0,1, seed=42). Ngưỡng -0,033527 chọn trên Validation theo max-F1-on-known-attacks, tách Backdoor & Worms.",
        evaluation:
          "Held-out Test (345.953 dòng): F1 0,5064, Precision 0,3523, Recall 0,8997, FPR 0,1605, ROC-AUC 0,893730. Họ tấn công chưa biết {Backdoor, Worms}: Recall 0,8657 (1.122 / 1.296).",
        limit:
          "Tỷ lệ báo động giả trên Benign Test còn cao (16,05%); xuất raw_anomaly_score (attack_probability là null). Tệp .joblib nằm ngoài Git.",
        link: source(
          "reports/experiments/isolation_forest/evaluation_report.md",
        ),
      },
      {
        id: "autoencoder",
        index: "04",
        name: "Autoencoder",
        type: "Unsupervised · lỗi tái tạo",
        status: "Đã đánh giá Held-out Test",
        statusClass: "validated",
        principle:
          "Mạng mã hóa-giải mã đối xứng (47 → 32 → 16 → 32 → 47) học tái tạo flow lành tính; sai số tái tạo MSE lớn báo hiệu bất thường.",
        role: "Đối chiếu phương pháp lỗi tái tạo với Isolation Forest dưới ngân sách FPR chặt chẽ trên Validation.",
        input:
          "Đầu vào: 1.590.608 flow lành tính (Benign) của tập Train sau biến đổi train-only.",
        method:
          "Run active ae_fpr_constrained_20261115T163000Z: ReLU + Adam, ngưỡng 17234985,792476 đóng băng trên Validation theo fpr_constrained (FPR mục tiêu ≤ 0,05; thực đo Val FPR 0,0500), tách Backdoor & Worms.",
        evaluation:
          "Held-out Test (345.953 dòng): F1 0,1361, Precision 0,1804, Recall 0,1093, FPR 0,0482, ROC-AUC 0,6303, PR-AUC 0,1615. Họ tấn công chưa biết {Backdoor, Worms}: Recall 0,0625 (81 / 1.296).",
        limit:
          "Recall thấp dưới ràng buộc FPR ≤ 0,05; run cũ ae_benign_quantile lưu riêng tại runs/. Tệp .joblib nằm ngoài Git (thiếu sẽ báo HTTP 503 fail-closed).",
        link: source("reports/evaluation/autoencoder/evaluation_report.md"),
      },
    ]
  : [
      {
        id: "random-forest",
        index: "01",
        name: "Random Forest",
        type: "Supervised · primary baseline",
        status: "Held-out Test verified",
        statusClass: "validated",
        principle:
          "An ensemble of decision trees votes on the binary flow label. It provides a strong, interpretable reference for later comparisons.",
        role: "Classify known benign versus attack flows under the 47-feature baseline contract.",
        input:
          "Inputs: 47 ordered NetFlow features; targets and six trace metadata fields are excluded.",
        method:
          "Canonical run: 200 trees, max depth 16, seed 42; chronological Train partition (1,655,797 rows), frozen train-only preprocessing, Validation and one-shot Held-out Test.",
        evaluation:
          "Validation F1 0.999869; Held-out Test (rf-heldout-ea330b9, 345,953 rows): F1 0.999853, Precision 0.999771, Recall 0.999935, FPR 0.000022 (TN=315,350, FP=7, FN=2, TP=30,594).",
        limit:
          "Feature importance and a shallow TTL-only diagnostic expose a strong testbed shortcut (MIN_TTL + MAX_TTL = 45.48%). Collapses on NF-CSE-CIC-IDS2018-v3 (Recall 0.0, FPR 0.3802). Binary .joblib stays outside Git.",
        link: source("reports/evaluation/error_analysis_report.md"),
      },
      {
        id: "xgboost",
        index: "02",
        name: "XGBoost",
        type: "Supervised · comparison baseline",
        status: "Held-out Test verified",
        statusClass: "validated",
        principle:
          "Gradient-boosted trees add models sequentially to reduce classification error on labelled flow data.",
        role: "Compare a second supervised learner with Random Forest under the same 47-feature contract and chronological split.",
        input: "Inputs: the same 47 ordered NetFlow features as Random Forest.",
        method:
          "Run xgb-baseline-1794755807: XGBClassifier (binary:logistic), 200 estimators, max depth 6, learning rate 0.1, subsample 0.8, colsample_bytree 0.8, tree_method hist, seed 42.",
        evaluation:
          "Validation F1 0.999984; Held-out Test (345,953 rows): F1 0.999984, Precision 0.999967, Recall 1.000000, FPR 0.000003, ROC-AUC 1.000000 (TN=315,356, FP=1, FN=0, TP=30,596).",
        limit:
          "Trained at commit 7f51390 with git_dirty=True prior to release commit; .joblib binary is outside Git (BLOCKED / NOT READY if missing locally). Same testbed TTL/overlap risks apply.",
        link: source("reports/evaluation/xgboost/evaluation_report.md"),
      },
      {
        id: "isolation-forest",
        index: "03",
        name: "Isolation Forest",
        type: "Unsupervised · anomaly score",
        status: "Held-out Test verified",
        statusClass: "validated",
        principle:
          "Random partitions isolate unusual observations quickly; shorter paths produce higher raw anomaly scores.",
        role: "Provide an anomaly-score detector fitted solely on benign flows without using attack labels for training.",
        input:
          "Inputs: 1,590,608 benign-only Train flows after frozen train-only preprocessing.",
        method:
          "Run if-c4-20261115T055359Z (clean commit bf0f3ec, 100 trees, contamination 0.1, seed 42). Threshold -0.033527 selected on Validation via max-F1-on-known-attacks with Backdoor & Worms held out.",
        evaluation:
          "Held-out Test (345,953 rows): F1 0.5064, Precision 0.3523, Recall 0.8997, FPR 0.1605, ROC-AUC 0.893730. Unknown holdout {Backdoor, Worms}: Recall 0.8657 (1,122 / 1,296).",
        limit:
          "High false-positive rate (16.05%) on benign Test flows; emits raw_anomaly_score (attack_probability is null). Binary .joblib stays outside Git.",
        link: source(
          "reports/experiments/isolation_forest/evaluation_report.md",
        ),
      },
      {
        id: "autoencoder",
        index: "04",
        name: "Autoencoder",
        type: "Unsupervised · reconstruction error",
        status: "Held-out Test verified",
        statusClass: "validated",
        principle:
          "A symmetric neural encoder-decoder (47 → 32 → 16 → 32 → 47) reconstructs benign inputs; larger MSE reconstruction error flags anomalous flows.",
        role: "Compare reconstruction-error anomaly detection against Isolation Forest under a strict Validation false-positive budget.",
        input:
          "Inputs: 1,590,608 benign-only Train flows after frozen train-only preprocessing.",
        method:
          "Active run ae_fpr_constrained_20261115T163000Z: ReLU + Adam, threshold 17234985.792476 frozen on Validation via fpr_constrained (target FPR ≤ 0.05; empirical Val FPR 0.0500), isolating Backdoor & Worms.",
        evaluation:
          "Held-out Test (345,953 rows): F1 0.1361, Precision 0.1804, Recall 0.1093, FPR 0.0482, ROC-AUC 0.6303, PR-AUC 0.1615. Unknown holdout {Backdoor, Worms}: Recall 0.0625 (81 / 1,296).",
        limit:
          "Low recall under the FPR ≤ 0.05 constraint; earlier ae_benign_quantile run archived separately in runs/. Binary .joblib stays outside Git (fail-closed HTTP 503 if missing).",
        link: source("reports/evaluation/autoencoder/evaluation_report.md"),
      },
    ];
---

<Layout
  title={isVi ? "Các mô hình AI" : "AI Models"}
  description={isVi
    ? "Bốn họ mô hình và kết quả Validation, Held-out Test trên dữ liệu thật."
    : "Four model families and their real-data Validation and Held-out Test status."}
  section="Models"
  lang={lang}
  routePath="models/"
>
  <PageIntro
    eyebrow={isVi ? "03 / Phương pháp mô hình" : "03 / Model methods"}
    current={isVi ? "Mô hình AI" : "AI Models"}
    title={isVi
      ? "Bốn hướng tiếp cận. Một chuẩn bằng chứng."
      : "Four approaches. One evidence standard."}
    description={isVi
      ? "Mỗi mô hình có cơ chế học, giao thức chọn ngưỡng và ngữ nghĩa đầu ra riêng. Cả bốn họ mô hình đều đã có báo cáo Train, Validation và Held-out Test trên NF-UNSW-NB15-v3."
      : "Each model has a distinct learning mechanism and evaluation protocol. All four families now have recorded Train, Validation and Held-out Test evidence on NF-UNSW-NB15-v3."}
    lang={lang}
  />
  <div class="container model-nav">
    <span>{isVi ? "CHUYỂN TỚI MÔ HÌNH" : "JUMP TO MODEL"}</span>{
      models.map((m) => (
        <a href={`#${m.id}`}>
          {m.index} {m.name}
        </a>
      ))
    }
  </div>
  {
    models.map((m) => (
      <section id={m.id} class="section model-section rule">
        <div class="container model-layout">
          <>
            <div>
              <>
                <span class="eyebrow">
                  {m.index} / {m.type}
                </span>
                <h2>{m.name}</h2>
                <span class={`status status-${m.statusClass}`}>{m.status}</span>
                <p class="lede principle">{m.principle}</p>
                <a class="source-link" href={m.link}>
                  {isVi
                    ? "Xem bằng chứng nguồn ↗"
                    : "Inspect source evidence ↗"}
                </a>
              </>
            </div>
            <div class="detail-grid">
              <>
                <div>
                  <>
                    <h3>{isVi ? "Vai trò kỳ vọng" : "Expected role"}</h3>
                    <p>{m.role}</p>
                  </>
                </div>
                <div>
                  <>
                    <h3>
                      {isVi ? "Đầu vào & huấn luyện" : "Inputs & training"}
                    </h3>
                    <p>
                      {m.input} {m.method}
                    </p>
                  </>
                </div>
                <div>
                  <>
                    <h3>{isVi ? "Đánh giá" : "Evaluation"}</h3>
                    <p>{m.evaluation}</p>
                  </>
                </div>
                <div>
                  <>
                    <h3>{isVi ? "Giới hạn" : "Limitation"}</h3>
                    <p>{m.limit}</p>
                  </>
                </div>
              </>
            </div>
          </>
        </div>
      </section>
    ))
  }
  <div class="container section">
    <div class="callout">
      <strong>{isVi ? "Ranh giới chung:" : "Shared boundary:"}</strong>{" "}
      {
        isVi
          ? "CSV gốc có 55 cột. Baseline dùng 47 đặc trưng mô hình, loại 6 trường metadata truy vết và 2 nhãn. Mô hình supervised trả về "
          : "The raw CSV has 55 columns. The baseline uses 47 model features, with six trace metadata fields and both targets excluded. Supervised models emit "
      }<code>attack_probability</code>{" "}
      {
        isVi
          ? "trong [0, 1]; mô hình unsupervised trả về "
          : "in [0, 1]; unsupervised detectors emit unclamped "
      }<code>raw_anomaly_score</code>{" "}
      {isVi ? "không cắt ngưỡng (và " : "(and Validation-calibrated "}<code
        >normalized_anomaly_score</code
      >{" "}
      {isVi ? "hiệu chuẩn theo Validation) với " : ") with "}<code
        >attack_probability = null</code
      >.{" "}
      {isVi ? "Thiếu tệp " : "Missing local "}<code>.joblib</code>{" "}
      {
        isVi ? "cục bộ sẽ bị khóa fail-closed ở " : "artifacts fail closed as "
      }<code>BLOCKED / NOT READY</code> (HTTP 503).
    </div>
  </div>
</Layout>
<style>
  .model-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.4rem;
    padding-bottom: 1.4rem;
  }
  .model-nav span {
    font:
      700 0.68rem ui-monospace,
      monospace;
    color: var(--muted);
    letter-spacing: 0.1em;
    margin-right: 1rem;
  }
  .model-nav a {
    font-size: 0.8rem;
    color: var(--cyan);
  }
  .model-section {
    scroll-margin-top: 80px;
  }
  .model-section:nth-of-type(even) {
    background: var(--surface);
  }
  .model-layout {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: 5rem;
  }
  .model-layout > div {
    min-width: 0;
  }
  .model-layout h2 {
    margin: 0.8rem 0;
  }
  .principle {
    margin: 2rem 0 1rem;
  }
  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2rem;
  }
  .detail-grid > div {
    min-width: 0;
    border-top: 1px solid var(--line);
    padding-top: 0.8rem;
  }
  .detail-grid h3 {
    font-size: 0.95rem;
    margin: 0.2rem 0;
  }
  .detail-grid p,
  .callout {
    overflow-wrap: anywhere;
  }
  .detail-grid p {
    color: var(--muted);
    font-size: 0.88rem;
    margin: 0.4rem 0;
  }
  @media (max-width: 800px) {
    .model-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
  @media (max-width: 550px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
