---
import Layout from "../../layouts/Layout.astro";
import PageIntro from "../../components/PageIntro.astro";
import { source, type Lang } from "../../lib/links";

interface Props {
  lang?: Lang;
}
const { lang = "vi" } = Astro.props;
const isVi = lang === "vi";

const models = isVi
  ? [
      {
        id: "random-forest",
        index: "01",
        name: "Random Forest",
        type: "Supervised (E0) · baseline nhị phân chính",
        status: "RESEARCH_ONLY · Đã đánh giá ait_test",
        statusClass: "validated",
        principle:
          "Tổ hợp cây quyết định bỏ phiếu xác suất tấn công trên hợp đồng 18 đặc trưng canonical-flow-v2-18; đóng vai trò mô hình supervised có F1 cao nhất trên AIT-NDS-v2.",
        role: "Phân loại nhị phân Benign và Attack (E0), đồng thời cung cấp biến thể E1 đa miền và Stage-2 RF_multiclass 6 lớp (Test Macro-F1 = 0.7347).",
        input:
          "Đầu vào: 18 đặc trưng canonical-flow-v2-18 sau TrainOnlyPreprocessor(asinh_robust, floor 0.25); loại trừ 5 trường truy vết, 5 trường provenance và 4 cột nhãn.",
        method:
          "Huấn luyện với seed=42 trên Train AIT-NDS-v2 (2,097,891 dòng: 1,825,866 Benign / 272,025 Attack), ngưỡng quyết định 0.5, kiểm định trên Validation (377,704 dòng) và Held-out Test (988,805 dòng: shaw, wheeler).",
        evaluation:
          "Held-out Test ait_test (N = 988,805): Precision 0.9989, Recall 0.9911, F1 0.9950, FPR 0.000246, ROC-AUC 0.9994 (TN=812,780, FP=200, FN=1,563, TP=174,262). Huấn luyện đa miền E1 (N_train=442,960) nâng CTU_Test F1 lên 0.9564.",
        limit:
          "Đánh giá zero-shot cross-source của E0 tụt xuống F1=0.0474 trên CTU-Echo và 0.0326–0.0738 trên CTU-Win7AD; Recall lớp thiểu số Credential_Attack ở RQ2 chỉ đạt 0.1410 (h2_full_confirmed = false). Giữ phân tầng RESEARCH_ONLY; tệp .joblib nằm ngoài Git.",
        link: source("reports/experiments/ml/model_comparison_report.json"),
      },
      {
        id: "xgboost",
        index: "02",
        name: "XGBoost",
        type: "Supervised (E0) · baseline đối chiếu",
        status: "RESEARCH_ONLY · Đã đánh giá ait_test",
        statusClass: "validated",
        principle:
          "Gradient-boosted decision trees tối ưu hàm mục tiêu nhị phân trên không gian 18 đặc trưng hành vi luồng L4 đã chuẩn hóa asinh_robust.",
        role: "Đối chiếu bộ phân loại supervised thứ hai với Random Forest trên cùng split tách biệt kịch bản v2-scenario-group-purged-v1.",
        input:
          "Đầu vào: cùng bộ 18 đặc trưng canonical-flow-v2-18 với Random Forest (6 đặc trưng cơ sở + 12 đặc trưng dẫn xuất).",
        method:
          "Huấn luyện với seed=42 trên 2,097,891 dòng Train, ngưỡng quyết định 0.5; đặc trưng quan trọng hàng đầu gồm bytes_in (0.3579) và bytes_per_sec_in (0.2121).",
        evaluation:
          "Held-out Test ait_test (N = 988,805): Precision 0.9989, Recall 0.8211, F1 0.9013, FPR 0.000198, ROC-AUC 0.9884 (TN=812,819, FP=161, FN=31,461, TP=144,364).",
        limit:
          "Zero-shot cross-source trên CTU-Echo chỉ đạt F1=0.1436 và trên CTU-Win7AD đạt 0.0326–0.0738 khi chưa qua thích nghi đa miền E1. Giữ phân tầng RESEARCH_ONLY; tệp .joblib nằm ngoài Git.",
        link: source("reports/experiments/ml/model_comparison_report.json"),
      },
      {
        id: "isolation-forest",
        index: "03",
        name: "Isolation Forest",
        type: "Unsupervised (E0) · cô lập điểm dị biệt",
        status: "RESEARCH_ONLY · Đã đánh giá ait_test",
        statusClass: "validated",
        principle:
          "Phân hoạch ngẫu nhiên cô lập các vector 18 chiều khác biệt so với phân phối Benign; điểm bất thường được chuẩn hóa theo phân vị thực nghiệm trên Validation Benign.",
        role: "Phát hiện bất thường không dùng nhãn Attack khi huấn luyện; đóng vai trò chủ lực cho phát hiện họ tấn công chưa biết (RQ4) và zero-shot sang CTU-Echo.",
        input:
          "Đầu vào: 1,825,866 flow Benign của tập Train AIT-NDS-v2 sau biến đổi TrainOnlyPreprocessor(asinh_robust).",
        method:
          "Huấn luyện chỉ trên Benign Train (seed=42), đóng băng ngưỡng 0.031268 từ manifest hiệu chuẩn trên Validation.",
        evaluation:
          "Held-out Test ait_test (N = 988,805): Precision 0.7775, Recall 0.4678, F1 0.5842, FPR 0.028952, ROC-AUC 0.8330 (TN=789,443, FP=23,537, FN=93,566, TP=82,259). Zero-shot trên CTU-Echo đạt F1=0.8853; RQ4 zero-day holdout (44 flows) đạt Recall=0.9091.",
        limit:
          "Recall tổng thể trên ait_test đạt 0.4678 do các luồng Reconnaissance mật độ thấp gần giống Benign; suy giảm trên CTU-Win7AD (F1 trong khoảng 0.0326–0.0738). Giữ phân tầng RESEARCH_ONLY; tệp .joblib nằm ngoài Git.",
        link: source("reports/experiments/ml/rq4_unknown_attack_report.json"),
      },
      {
        id: "autoencoder",
        index: "04",
        name: "Autoencoder",
        type: "Unsupervised (E0) · lỗi tái tạo MLP",
        status: "RESEARCH_ONLY · Đã đánh giá ait_test",
        statusClass: "validated",
        principle:
          "Mạng nơ-ron MLP đối xứng 18-16-8-16-18 học tái tạo biểu diễn asinh_robust của luồng Benign; sai số tái tạo vượt ngưỡng báo hiệu bất thường.",
        role: "Đối chiếu phát hiện bất thường dựa trên lỗi tái tạo với Isolation Forest và khảo sát hiệu chuẩn ngưỡng đa miền (Autoencoder_E3b).",
        input:
          "Đầu vào: 1,825,866 flow Benign của tập Train AIT-NDS-v2 trên hợp đồng 18 đặc trưng canonical-flow-v2-18.",
        method:
          "Kiến trúc MLP 18-16-8-16-18 (seed=42), ngưỡng quyết định 0.000467 đóng băng từ Validation Benign; biến thể Autoencoder_E3b đánh giá hiệu chuẩn giảm FPR trên miền đích.",
        evaluation:
          "Held-out Test ait_test (N = 988,805): Precision 0.7860, Recall 0.4693, F1 0.5877, FPR 0.027637, ROC-AUC 0.5544 (TN=790,512, FP=22,468, FN=93,317, TP=82,508). Zero-shot trên CTU-Echo đạt F1=0.7325; Autoencoder_E3b giảm FPR trên CTU-Win7AD từ 72.14% xuống 13.79%.",
        limit:
          "Trên tập holdout zero-day 44 flow (RQ4), Recall chỉ đạt 0.2045 nên giả thuyết unsupervised_ge_0_75_both = false. Giữ phân tầng RESEARCH_ONLY; tệp .joblib nằm ngoài Git.",
        link: source(
          "reports/experiments/ml/e1_multidomain_experiment_report.json",
        ),
      },
    ]
  : [
      {
        id: "random-forest",
        index: "01",
        name: "Random Forest",
        type: "Supervised (E0) · primary binary baseline",
        status: "RESEARCH_ONLY · Verified on ait_test",
        statusClass: "validated",
        principle:
          "An ensemble of decision trees votes on binary attack probability over the 18-feature canonical-flow-v2-18 contract, serving as the highest-F1 supervised baseline on AIT-NDS-v2.",
        role: "Binary Benign vs Attack classification (E0), plus multi-domain E1 adaptation and Stage-2 6-class RF_multiclass attribution (Test Macro-F1 = 0.7347).",
        input:
          "Inputs: 18 canonical-flow-v2-18 features transformed via TrainOnlyPreprocessor(asinh_robust, floor 0.25); 5 trace metadata, 5 provenance and 4 label columns are excluded.",
        method:
          "Trained with seed=42 on AIT-NDS-v2 Train (2,097,891 rows: 1,825,866 Benign / 272,025 Attack), decision threshold 0.5, validated on 377,704 rows and tested on 988,805 Held-out Test rows (shaw, wheeler).",
        evaluation:
          "Held-out Test ait_test (N = 988,805): Precision 0.9989, Recall 0.9911, F1 0.9950, FPR 0.000246, ROC-AUC 0.9994 (TN=812,780, FP=200, FN=1,563, TP=174,262). Multi-domain E1 (N_train=442,960) lifts CTU_Test F1 to 0.9564.",
        limit:
          "Zero-shot cross-source E0 drops to F1=0.0474 on CTU-Echo and 0.0326–0.0738 on CTU-Win7AD; minority Credential_Attack recall in RQ2 is 0.1410 (h2_full_confirmed = false). Tier remains RESEARCH_ONLY; .joblib stays outside Git.",
        link: source("reports/experiments/ml/model_comparison_report.json"),
      },
      {
        id: "xgboost",
        index: "02",
        name: "XGBoost",
        type: "Supervised (E0) · comparison baseline",
        status: "RESEARCH_ONLY · Verified on ait_test",
        statusClass: "validated",
        principle:
          "Gradient-boosted decision trees optimize binary classification over the asinh_robust-scaled 18-dimensional L4 flow feature space.",
        role: "Compare a second supervised family against Random Forest under the same scenario-disjoint split (v2-scenario-group-purged-v1).",
        input:
          "Inputs: the same 18 canonical-flow-v2-18 features as Random Forest (6 base observed + 12 deterministic derived).",
        method:
          "Trained with seed=42 on 2,097,891 Train rows, decision threshold 0.5; top tree importance features are bytes_in (0.3579) and bytes_per_sec_in (0.2121).",
        evaluation:
          "Held-out Test ait_test (N = 988,805): Precision 0.9989, Recall 0.8211, F1 0.9013, FPR 0.000198, ROC-AUC 0.9884 (TN=812,819, FP=161, FN=31,461, TP=144,364).",
        limit:
          "Zero-shot cross-source evaluation reaches F1=0.1436 on CTU-Echo and 0.0326–0.0738 on CTU-Win7AD without multi-domain E1 training. Tier remains RESEARCH_ONLY; .joblib stays outside Git.",
        link: source("reports/experiments/ml/model_comparison_report.json"),
      },
      {
        id: "isolation-forest",
        index: "03",
        name: "Isolation Forest",
        type: "Unsupervised (E0) · anomaly isolation",
        status: "RESEARCH_ONLY · Verified on ait_test",
        statusClass: "validated",
        principle:
          "Random tree partitions isolate 18-D flow vectors that diverge from the benign training manifold, scored via empirical percentiles against Validation benign flows.",
        role: "Provide an unsupervised detector trained without attack labels; primary candidate for unknown attack holdouts (RQ4) and zero-shot CTU-Echo transfer.",
        input:
          "Inputs: 1,825,866 benign-only Train flows from AIT-NDS-v2 after frozen TrainOnlyPreprocessor(asinh_robust).",
        method:
          "Fitted on benign-only Train (seed=42) with decision threshold 0.031268 frozen from Validation calibration.",
        evaluation:
          "Held-out Test ait_test (N = 988,805): Precision 0.7775, Recall 0.4678, F1 0.5842, FPR 0.028952, ROC-AUC 0.8330 (TN=789,443, FP=23,537, FN=93,566, TP=82,259). Reaches zero-shot F1=0.8853 on CTU-Echo and Recall=0.9091 on the 44-flow zero-day holdout (RQ4).",
        limit:
          "Overall ait_test recall is 0.4678 due to low-rate Reconnaissance flows overlapping benign density; degrades on CTU-Win7AD (F1 0.0326–0.0738). Tier remains RESEARCH_ONLY; .joblib stays outside Git.",
        link: source("reports/experiments/ml/rq4_unknown_attack_report.json"),
      },
      {
        id: "autoencoder",
        index: "04",
        name: "Autoencoder",
        type: "Unsupervised (E0) · MLP reconstruction error",
        status: "RESEARCH_ONLY · Verified on ait_test",
        statusClass: "validated",
        principle:
          "A symmetric 18-16-8-16-18 MLP neural network reconstructs asinh_robust benign flow representations; elevated reconstruction error flags anomalies.",
        role: "Compare neural reconstruction-error anomaly detection against Isolation Forest and evaluate multi-domain false-positive reduction (Autoencoder_E3b).",
        input:
          "Inputs: 1,825,866 benign-only Train flows from AIT-NDS-v2 under the 18-feature canonical-flow-v2-18 contract.",
        method:
          "MLP architecture 18-16-8-16-18 (seed=42) with decision threshold 0.000467 frozen on Validation benign flows; Autoencoder_E3b tests domain-calibrated thresholding.",
        evaluation:
          "Held-out Test ait_test (N = 988,805): Precision 0.7860, Recall 0.4693, F1 0.5877, FPR 0.027637, ROC-AUC 0.5544 (TN=790,512, FP=22,468, FN=93,317, TP=82,508). Reaches zero-shot F1=0.7325 on CTU-Echo; Autoencoder_E3b reduces CTU-Win7AD FPR from 72.14% to 13.79%.",
        limit:
          "On the 44-flow zero-day holdout (RQ4), Recall is 0.2045, leaving unsupervised_ge_0_75_both = false. Tier remains RESEARCH_ONLY; .joblib stays outside Git.",
        link: source(
          "reports/experiments/ml/e1_multidomain_experiment_report.json",
        ),
      },
    ];
---

<Layout
  title={isVi ? "Các mô hình AI" : "AI Models"}
  description={isVi
    ? "Bốn họ mô hình E0 (RESEARCH_ONLY), biến thể đa miền E1/E3b và phân loại 6 lớp trên hợp đồng canonical-flow-v2-18."
    : "Four E0 model families (RESEARCH_ONLY), multi-domain E1/E3b variants and 6-class attribution under canonical-flow-v2-18."}
  section="Models"
  lang={lang}
  routePath="models/"
>
  <PageIntro
    eyebrow={isVi ? "03 / Phương pháp mô hình v2.0" : "03 / Model methods v2.0"}
    current={isVi ? "Mô hình AI" : "AI Models"}
    title={isVi
      ? "Bốn họ mô hình E0. Một hợp đồng 18 đặc trưng."
      : "Four E0 model families. One 18-feature contract."}
    description={isVi
      ? "Tất cả bốn họ mô hình E0 (Random Forest, XGBoost, Isolation Forest, Autoencoder) đều được huấn luyện với seed = 42 trên AIT-NDS-v2, đánh giá trên 988,805 dòng ait_test và giữ phân tầng RESEARCH_ONLY."
      : "All four E0 model families (Random Forest, XGBoost, Isolation Forest, Autoencoder) are trained with seed = 42 on AIT-NDS-v2, evaluated on 988,805 ait_test rows and classified as RESEARCH_ONLY."}
    lang={lang}
  />
  <div class="container model-nav">
    <span>{isVi ? "CHUYỂN TỚI MÔ HÌNH" : "JUMP TO MODEL"}</span>{
      models.map((m) => (
        <a href={`#${m.id}`}>
          {m.index} {m.name}
        </a>
      ))
    }
  </div>
  {
    models.map((m) => (
      <section id={m.id} class="section model-section rule">
        <div class="container model-layout">
          <>
            <div>
              <>
                <span class="eyebrow">
                  {m.index} / {m.type}
                </span>
                <h2>{m.name}</h2>
                <span class={`status status-${m.statusClass}`}>{m.status}</span>
                <p class="lede principle">{m.principle}</p>
                <a class="source-link" href={m.link}>
                  {isVi
                    ? "Xem bằng chứng nguồn ↗"
                    : "Inspect source evidence ↗"}
                </a>
              </>
            </div>
            <div class="detail-grid">
              <>
                <div>
                  <>
                    <h3>{isVi ? "Vai trò kỳ vọng" : "Expected role"}</h3>
                    <p>{m.role}</p>
                  </>
                </div>
                <div>
                  <>
                    <h3>
                      {isVi ? "Đầu vào & huấn luyện" : "Inputs & training"}
                    </h3>
                    <p>
                      {m.input} {m.method}
                    </p>
                  </>
                </div>
                <div>
                  <>
                    <h3>{isVi ? "Đánh giá" : "Evaluation"}</h3>
                    <p>{m.evaluation}</p>
                  </>
                </div>
                <div>
                  <>
                    <h3>{isVi ? "Giới hạn" : "Limitation"}</h3>
                    <p>{m.limit}</p>
                  </>
                </div>
              </>
            </div>
          </>
        </div>
      </section>
    ))
  }
  <div class="container section">
    <div class="callout">
      <strong>
        {
          isVi
            ? "Ranh giới chung & quản trị mô hình:"
            : "Shared boundary & model governance:"
        }
      </strong>{" "}
      {
        isVi
          ? "Hợp đồng canonical-flow-v2-18 sử dụng 18 đặc trưng ML (6 cơ sở + 12 dẫn xuất), loại trừ hoàn toàn TTL và metadata định danh. Cả 4 mô hình E0 hiện giữ cấp độ "
          : "The canonical-flow-v2-18 contract uses 18 ML features (6 base + 12 derived), excluding lab TTLs and identity metadata. All 4 E0 models remain classified as "
      }<code>RESEARCH_ONLY</code>{" "}
      {isVi ? "trong " : "in "}<a
        href={source("src/network_anomaly/models/registry.py")}
        ><code>models/registry.py</code> ↗</a
      >;{" "}
      {
        isVi
          ? "chế độ mặc định fail-closed runtime_mode = 'deployment' bắt buộc xác minh "
          : "the default fail-closed runtime_mode = 'deployment' requires a trusted "
      }<code>NETFLOW_OOD_GATE_SHA256</code>{" "}
      {isVi ? "và từ chối nguồn " : "and blocks "}<code
        >FEATURE_INCOMPATIBLE</code
      >.
    </div>
  </div>
</Layout>
<style>
  .model-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.4rem;
    padding-bottom: 1.4rem;
  }
  .model-nav span {
    font:
      700 0.68rem ui-monospace,
      monospace;
    color: var(--muted);
    letter-spacing: 0.1em;
    margin-right: 1rem;
  }
  .model-nav a {
    font-size: 0.8rem;
    color: var(--cyan);
  }
  .model-section {
    scroll-margin-top: 80px;
  }
  .model-section:nth-of-type(even) {
    background: var(--surface);
  }
  .model-layout {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: 5rem;
  }
  .model-layout > div {
    min-width: 0;
  }
  .model-layout h2 {
    margin: 0.8rem 0;
  }
  .principle {
    margin: 2rem 0 1rem;
  }
  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2rem;
  }
  .detail-grid > div {
    min-width: 0;
    border-top: 1px solid var(--line);
    padding-top: 0.8rem;
  }
  .detail-grid h3 {
    font-size: 0.95rem;
    margin: 0.2rem 0;
  }
  .detail-grid p,
  .callout {
    overflow-wrap: anywhere;
  }
  .detail-grid p {
    color: var(--muted);
    font-size: 0.88rem;
    margin: 0.4rem 0;
  }
  @media (max-width: 800px) {
    .model-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
  @media (max-width: 550px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
