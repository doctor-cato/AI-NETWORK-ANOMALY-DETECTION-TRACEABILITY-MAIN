---
import Layout from "../../layouts/Layout.astro";
import { href, repository, source, type Lang } from "../../lib/links";

interface Props {
  lang?: Lang;
}
const { lang = "vi" } = Astro.props;
const isVi = lang === "vi";

const copy = isVi
  ? {
      title: "Trang chủ",
      description:
        "NetFlow Sentinel v2.0: nghiên cứu phát hiện bất thường lưu lượng mạng đa nguồn, truy vết hành vi 16-D và xoay khóa thích ứng dựa trên bằng chứng.",
      eyebrow:
        "NetFlow Sentinel v2.0 · AIT-NDS-v2 · CTU-SME-11 · UWF-ZeekData24",
      h1a: "Phát hiện bất thường.",
      h1b: "Truy vết bằng chứng.",
      lede: "Functional Prototype / Academic & Controlled Lab Pilot (RESEARCH_ONLY, approved = false) sau bước Hard Cutover khỏi v1. Hệ thống tích hợp hợp đồng 18 đặc trưng canonical-flow-v2-18, 3 chế độ vận hành (Offline CSV, Dataset Replay, Live Lab Monitoring), vector hành vi 16-D và xoay khóa AES-256-GCM thích ứng.",
      ctaPrimary: "Xem bằng chứng thực nghiệm",
      ctaSecondary: "Xem repository",
      badge: "Prototype nghiên cứu (v2.0.0 · RESEARCH_ONLY)",
      portalNote:
        "Cổng tài liệu tĩnh · không xử lý lưu lượng hay suy luận trực tiếp",
      panelTitle: "PIPELINE NGHIÊN CỨU V2.0 / 002",
      steps: [
        [
          "01",
          "AIT-NDS-v2 & Đa nguồn v2",
          "3,464,400 dòng AIT · CTU-SME-11 (251,219) · UWF (95,871)",
          "ĐÃ XÁC MINH",
          false,
        ],
        [
          "02",
          "canonical-flow-v2-18 & cổng OOD",
          "18 đặc trưng (6 gốc + 12 dẫn xuất) · asinh_robust (floor 0.25)",
          "ĐÃ TRIỂN KHAI",
          false,
        ],
        [
          "03",
          "4 mô hình E0, E1 đa miền & RQ1–RQ6",
          "RF · XGBoost · Autoencoder · IF (N_test = 988,805)",
          "ĐÃ KIỂM CHỨNG",
          false,
        ],
        [
          "04",
          "3 chế độ vận hành & Desktop v2.0.0",
          "Offline CSV · Replay 399.44 flow/s · Live UDP NetFlow (netflow-rs)",
          "PROTOTYPE LAB",
          true,
        ],
      ] as const,
      panelFoot: "HARD CUTOVER V1 → V2 · FAIL-CLOSED DEPLOYMENT",
      metrics: [
        ["3,46M", "dòng flow AIT-NDS-v2 có nhãn (+ 942 loại trừ)"],
        ["18", "đặc trưng canonical-flow-v2-18 (6 gốc + 12 dẫn xuất)"],
        ["4", "mô hình E0 RESEARCH_ONLY + E1 đa miền & 6-class RF"],
        [
          "33 / 35",
          "OpenAPI paths / operations (676 pytest · 41 Vitest · 17 Rust)",
        ],
      ] as const,
      qEyebrow: "Câu hỏi nghiên cứu RQ1–RQ6",
      qTitle: "Từ shortcut v1 tới kiến trúc đa nguồn v2.0.",
      qText:
        "Sau khi v1 (NF-UNSW-NB15-v3) bị loại bỏ hoàn toàn sang historical/ vì đường tắt MIN_TTL/MAX_TTL và sụp đổ OOD (Recall=0.0, FPR=0.3802), NetFlow Sentinel v2.0 khảo sát 6 câu hỏi nghiên cứu (RQ1–RQ6) trên split tách biệt kịch bản (v2-scenario-group-purged-v1), vector hành vi 16-D, zero-day holdout và xoay khóa AES-256-GCM thích ứng.",
      qLink: "Đọc phạm vi nghiên cứu v2.0",
      tEyebrow: "Các hướng mô hình (E0 · RESEARCH_ONLY)",
      tTitle: "Bốn họ mô hình E0 trên ait_test (N = 988,805).",
      tText:
        "Huấn luyện với seed = 42 trên 2,097,891 dòng Train, hiệu chuẩn trên 377,704 dòng Validation và đánh giá trên 988,805 dòng Held-out Test (shaw, wheeler), kèm đánh giá dịch chuyển miền CTU-SME-11 (E1/E3b).",
      models: [
        [
          "#random-forest",
          "01 / SUPERVISED (E0)",
          "Random Forest",
          "Baseline nhị phân chính trên ait_test: Precision 0.9989, Recall 0.9911, F1 0.9950, FPR 0.000246, ROC-AUC 0.9994. Đa miền E1 nâng CTU_Test F1 lên 0.9564.",
          "RESEARCH_ONLY · Đã kiểm chứng",
        ],
        [
          "#xgboost",
          "02 / SUPERVISED (E0)",
          "XGBoost",
          "Gradient-boosted trees trên ait_test: Precision 0.9989, Recall 0.8211, F1 0.9013, FPR 0.000198, ROC-AUC 0.9884.",
          "RESEARCH_ONLY · Đã kiểm chứng",
        ],
        [
          "#isolation-forest",
          "03 / UNSUPERVISED (E0)",
          "Isolation Forest",
          "Huấn luyện chỉ trên Benign Train: P 0.7775, R 0.4678, F1 0.5842, FPR 0.028952, ROC-AUC 0.8330. Đạt F1 zero-shot 0.8853 trên CTU-Echo và Recall 0.9091 trên 44 flow zero-day (RQ4).",
          "RESEARCH_ONLY · Đã kiểm chứng",
        ],
        [
          "#autoencoder",
          "04 / UNSUPERVISED (E0)",
          "Autoencoder",
          "MLP 18-16-8-16-18 chỉ trên Benign Train: P 0.7860, R 0.4693, F1 0.5877, FPR 0.027637, ROC-AUC 0.5544. Biến thể E3b giảm FPR trên CTU-Win7AD từ 72.14% xuống 13.79%.",
          "RESEARCH_ONLY · Đã kiểm chứng",
        ],
      ] as const,
      eEyebrow: "3 chế độ vận hành & bằng chứng v2.0",
      eTitle1: "Ba chế độ vận hành.",
      eTitle2: "Ranh giới pháp lý & kỹ thuật rõ ràng.",
      eLede:
        "NetFlow Sentinel v2.0.0 vận hành fail-closed (runtime_mode = 'deployment' yêu cầu NETFLOW_OOD_GATE_SHA256), khóa ResponsePolicy ở dry_run = True (executed = false) và được kiểm chứng lặp lại 2x trạng thái sạch qua scripts/verify_clean_state_demo.py.",
      eButton: "Xem lộ trình & hạng mục DEFERRED",
      evidences: [
        [
          "01",
          "Chế độ 1 & 2: Offline CSV (200 flows) & Dataset Replay (399.44 flow/s)",
          "Offline CSV chạy data/demo/demo_flows.csv với 4/4 REAL_MODELS, OOD=FITTED và 2x clean-state repeatability; Dataset Replay phát trực tiếp ait_test.csv.gz theo micro-batch 32 đạt 399.44 flow/s.",
        ],
        [
          "02",
          "Chế độ 3: Live Lab Monitoring (UDP NetFlow v9/IPFIX + netflow-rs)",
          "Collector pure-Rust (telemetry/netflow-rs/) kết hợp LiveLogTailer trên 127.0.0.1, AES-256-GCM (72,177.2 ops/s ở 256B, P95 13.3 µs) + Windows DPAPI keystore. Lab phần cứng vật lý (#137) giữ trạng thái DEFERRED.",
        ],
        [
          "03",
          "Ranh giới dữ liệu, giấy phép & phân phối nhị phân",
          "AIT-NDS-v2 & CTU-SME-11 theo CC BY 4.0; UWF-ZeekData24 chỉ dùng đánh giá (evaluation_only = true); AIT-LDS-v2.1 (CC BY-NC-SA 4.0) cách ly tuyệt đối (0% rò rỉ, #85 chứng minh DIRECT_UID_LINK = FALSE); DISTRIBUTION_AUTHORIZATION.json giữ approved = false.",
        ],
      ] as const,
      cEyebrow: "Bắt đầu từ hồ sơ gốc v2.0",
      cTitle: "Đối chiếu mọi tuyên bố tới mã nguồn.",
      cText:
        "Đọc báo cáo nghiên cứu v2.0, kiểm tra kết quả RQ1–RQ6 trên 988,805 dòng ait_test và xem biên bản kiểm toán phát hành.",
      cPrimary: "Xem tài liệu kỹ thuật",
      cSecondary: "Xem kiểm toán sẵn sàng v2.0",
    }
  : {
      title: "Home",
      description:
        "NetFlow Sentinel v2.0: evidence-led research into multi-source network-flow anomaly detection, 16-D behavioral traceability and adaptive key rotation.",
      eyebrow:
        "NetFlow Sentinel v2.0 · AIT-NDS-v2 · CTU-SME-11 · UWF-ZeekData24",
      h1a: "Detect the anomaly.",
      h1b: "Trace the evidence.",
      lede: "Classified as a Functional Prototype / Academic & Controlled Lab Pilot (RESEARCH_ONLY, approved = false) following a hard cutover from v1. The system combines the 18-feature canonical-flow-v2-18 contract, three operation modes (Offline CSV, Dataset Replay, Live Lab Monitoring), 16-D behavioral vectors and adaptive AES-256-GCM key rotation.",
      ctaPrimary: "Explore the evidence",
      ctaSecondary: "View repository",
      badge: "Research prototype (v2.0.0 · RESEARCH_ONLY)",
      portalNote: "Static documentation portal · no live traffic or inference",
      panelTitle: "RESEARCH PIPELINE V2.0 / 002",
      steps: [
        [
          "01",
          "AIT-NDS-v2 & Multi-source v2",
          "3,464,400 AIT rows · CTU-SME-11 (251,219) · UWF (95,871)",
          "VERIFIED",
          false,
        ],
        [
          "02",
          "canonical-flow-v2-18 & OOD gate",
          "18 features (6 base + 12 derived) · asinh_robust (floor 0.25)",
          "IMPLEMENTED",
          false,
        ],
        [
          "03",
          "Four E0 models, multi-domain E1 & RQ1–RQ6",
          "RF · XGBoost · Autoencoder · IF (N_test = 988,805)",
          "VALIDATED",
          false,
        ],
        [
          "04",
          "3 Operation Modes & Desktop v2.0.0",
          "Offline CSV · Replay 399.44 flow/s · Live UDP NetFlow (netflow-rs)",
          "LAB PILOT",
          true,
        ],
      ] as const,
      panelFoot: "HARD CUTOVER V1 → V2 · FAIL-CLOSED DEPLOYMENT",
      metrics: [
        ["3.46M", "labeled AIT-NDS-v2 flow rows (+ 942 excluded)"],
        ["18", "canonical-flow-v2-18 ML features (6 base + 12 derived)"],
        ["4", "RESEARCH_ONLY E0 models + multi-domain E1 & 6-class RF"],
        [
          "33 / 35",
          "OpenAPI paths / operations (676 pytest · 41 Vitest · 17 Rust)",
        ],
      ] as const,
      qEyebrow: "Research questions RQ1–RQ6",
      qTitle: "From v1 testbed shortcuts to v2.0 multi-source architecture.",
      qText:
        "After v1 (NF-UNSW-NB15-v3) was retired to historical/ due to MIN_TTL/MAX_TTL shortcuts and OOD collapse (Recall=0.0, FPR=0.3802), NetFlow Sentinel v2.0 evaluates six research questions (RQ1–RQ6) across a scenario-disjoint split (v2-scenario-group-purged-v1), 16-D BehavioralVector correlation, zero-day holdouts and adaptive AES-256-GCM key rotation.",
      qLink: "Read the v2.0 research scope",
      tEyebrow: "Model tracks (E0 · RESEARCH_ONLY)",
      tTitle: "Four E0 model families on ait_test (N = 988,805).",
      tText:
        "Trained with seed = 42 on 2,097,891 Train flows, calibrated on 377,704 Validation flows and evaluated on 988,805 Held-out Test flows (shaw, wheeler), alongside CTU-SME-11 domain-shift experiments (E1/E3b).",
      models: [
        [
          "#random-forest",
          "01 / SUPERVISED (E0)",
          "Random Forest",
          "Primary binary baseline on ait_test: Precision 0.9989, Recall 0.9911, F1 0.9950, FPR 0.000246, ROC-AUC 0.9994. Multi-domain E1 lifts CTU_Test F1 to 0.9564.",
          "RESEARCH_ONLY · Validated",
        ],
        [
          "#xgboost",
          "02 / SUPERVISED (E0)",
          "XGBoost",
          "Gradient-boosted trees on ait_test: Precision 0.9989, Recall 0.8211, F1 0.9013, FPR 0.000198, ROC-AUC 0.9884.",
          "RESEARCH_ONLY · Validated",
        ],
        [
          "#isolation-forest",
          "03 / UNSUPERVISED (E0)",
          "Isolation Forest",
          "Benign-only Train fit: P 0.7775, R 0.4678, F1 0.5842, FPR 0.028952, ROC-AUC 0.8330. Reaches 0.8853 zero-shot F1 on CTU-Echo and 0.9091 Recall on the 44-flow zero-day holdout (RQ4).",
          "RESEARCH_ONLY · Validated",
        ],
        [
          "#autoencoder",
          "04 / UNSUPERVISED (E0)",
          "Autoencoder",
          "MLP 18-16-8-16-18 on benign-only Train: P 0.7860, R 0.4693, F1 0.5877, FPR 0.027637, ROC-AUC 0.5544. Autoencoder_E3b cuts CTU-Win7AD FPR from 72.14% to 13.79%.",
          "RESEARCH_ONLY · Validated",
        ],
      ] as const,
      eEyebrow: "3 operation modes & v2.0 evidence",
      eTitle1: "Three operation modes.",
      eTitle2: "Explicit legal and technical boundaries.",
      eLede:
        "NetFlow Sentinel v2.0.0 runs fail-closed by default (runtime_mode = 'deployment' requiring NETFLOW_OOD_GATE_SHA256), locks ResponsePolicy at dry_run = True (executed = false), and verifies 2x clean-state repeatability via scripts/verify_clean_state_demo.py.",
      eButton: "View roadmap & DEFERRED items",
      evidences: [
        [
          "01",
          "Modes 1 & 2: Offline CSV (200 flows) & Dataset Replay (399.44 flow/s)",
          "Offline CSV evaluates data/demo/demo_flows.csv with 4/4 REAL_MODELS, OOD=FITTED and 2x clean-state repeatability; Dataset Replay streams ait_test.csv.gz at micro-batch 32 achieving 399.44 flow/s.",
        ],
        [
          "02",
          "Mode 3: Live Lab Monitoring (UDP NetFlow v9/IPFIX + netflow-rs)",
          "Pure-Rust collector (telemetry/netflow-rs/) paired with LiveLogTailer on 127.0.0.1, AES-256-GCM (72,177.2 ops/s at 256B, P95 13.3 µs) + Windows DPAPI keystore. Physical router/switch lab (#137) remains DEFERRED.",
        ],
        [
          "03",
          "Dataset, license & binary distribution boundaries",
          "AIT-NDS-v2 & CTU-SME-11 use CC BY 4.0; UWF-ZeekData24 is evaluation_only = true; AIT-LDS-v2.1 (CC BY-NC-SA 4.0) is strictly isolated (0% leakage, #85 proved DIRECT_UID_LINK = FALSE); DISTRIBUTION_AUTHORIZATION.json keeps approved = false.",
        ],
      ] as const,
      cEyebrow: "Start with the v2.0 record",
      cTitle: "Follow each claim to its source.",
      cText:
        "Read the v2.0 research report, inspect the RQ1–RQ6 findings across 988,805 ait_test flows, and review the release readiness audit.",
      cPrimary: "Browse documentation",
      cSecondary: "Inspect v2.0 readiness audit",
    };
---

<Layout
  title={copy.title}
  description={copy.description}
  lang={lang}
  routePath=""
>
  <section class="hero grid-lines">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1>{copy.h1a}<br /><em>{copy.h1b}</em></h1>
        <p class="lede">{copy.lede}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={href("results/", lang)}
            >{copy.ctaPrimary} <span aria-hidden="true">↗</span></a
          ><a class="button" href={repository}
            >{copy.ctaSecondary} <span aria-hidden="true">↗</span></a
          >
        </div>
        <div class="hero-note">
          <span class="status status-progress">{copy.badge}</span><span
            >{copy.portalNote}</span
          >
        </div>
      </div>
      <div class="signal-panel" role="region" aria-label={copy.panelTitle}>
        <div class="panel-top">
          <span>{copy.panelTitle}</span><span
            class="panel-dots"
            aria-hidden="true">● ● ●</span
          >
        </div>
        {
          copy.steps.map(([idx, title, desc, state, planned], i) => (
            <>
              {i > 0 && (
                <div
                  class={`flow-connector ${planned ? "muted-connector" : ""}`}
                  aria-hidden="true"
                />
              )}
              <div class={`flow-step ${planned ? "planned" : ""}`}>
                <span class="flow-index">{idx}</span>
                <div>
                  <strong>{title}</strong>
                  <small>{desc}</small>
                </div>
                <span class="flow-state">{state}</span>
              </div>
            </>
          ))
        }
        <div class="panel-foot">
          <span>{copy.panelFoot}</span><span>↗</span>
        </div>
      </div>
    </div>
  </section>

  <section class="metrics-strip rule">
    <div class="container metrics-grid">
      {
        copy.metrics.map(([value, label]) => (
          <div>
            <strong>{value}</strong>
            <span>{label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="container split-heading">
      <div>
        <span class="eyebrow">{copy.qEyebrow}</span><h2>{copy.qTitle}</h2>
      </div><div>
        <p class="lede">{copy.qText}</p><a
          class="text-link"
          href={href("research/", lang)}
          >{copy.qLink} <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </section>

  <section class="section tinted rule">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">{copy.tEyebrow}</span><h2>{copy.tTitle}</h2><p>
          {copy.tText}
        </p>
      </div><div class="model-grid">
        {
          copy.models.map(([hash, num, name, desc, status]) => (
            <a class="model-card" href={href(`models/${hash}`, lang)}>
              <span class="model-number">{num}</span>
              <h3>{name}</h3>
              <p>{desc}</p>
              <span class="status status-validated">{status}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container evidence-grid">
      <div>
        <span class="eyebrow">{copy.eEyebrow}</span><h2>
          {copy.eTitle1}<br />{copy.eTitle2}
        </h2><p class="lede">{copy.eLede}</p><a
          class="button"
          href={href("roadmap/", lang)}>{copy.eButton} ↗</a
        >
      </div><div class="evidence-list">
        {
          copy.evidences.map(([idx, title, desc]) => (
            <div>
              <span>{idx}</span>
              <p>
                <strong>{title}</strong>
                <br />
                {desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section closing rule">
    <div class="container">
      <span class="eyebrow">{copy.cEyebrow}</span><h2>{copy.cTitle}</h2><p>
        {copy.cText}
      </p><div class="hero-actions">
        <a class="button button-primary" href={href("docs/", lang)}
          >{copy.cPrimary} ↗</a
        ><a class="button" href={source("docs/audits/V2_RELEASE_READINESS.md")}
          >{copy.cSecondary} ↗</a
        >
      </div>
    </div>
  </section>
</Layout>
<style>
  .hero {
    padding: 5.4rem 0 5.8rem;
    position: relative;
    overflow: hidden;
  }
  .hero:before {
    content: "";
    position: absolute;
    width: 600px;
    height: 600px;
    right: -100px;
    top: -300px;
    background: radial-gradient(circle, #26698038, transparent 70%);
    pointer-events: none;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: center;
    position: relative;
  }
  .hero h1 {
    margin: 1.2rem 0 1.4rem;
    max-width: 14ch;
  }
  .hero h1 em {
    font-style: normal;
    color: var(--cyan);
  }
  .hero .lede {
    max-width: 54ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }
  .hero-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 3rem;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .signal-panel {
    background: linear-gradient(145deg, var(--surface), #0a192b);
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    box-shadow: var(--shadow);
    padding: 1.3rem;
    color: #eaf5fa;
  }
  .panel-top,
  .panel-foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font:
      700 0.65rem/1.3 ui-monospace,
      SFMono-Regular,
      monospace;
    letter-spacing: 0.1em;
    color: #86a9ba;
  }
  .panel-top {
    padding-bottom: 1.2rem;
    border-bottom: 1px solid #294056;
  }
  .panel-dots {
    color: var(--cyan);
    letter-spacing: 0.4em;
  }
  .flow-step {
    display: flex;
    align-items: center;
    gap: 1rem;
    border: 1px solid #375269;
    background: #12273a;
    padding: 1rem 0.8rem;
    border-radius: 0.25rem;
  }
  .flow-step > div {
    flex: 1;
    min-width: 0;
  }
  .flow-step strong,
  .flow-step small {
    display: block;
  }
  .flow-step strong {
    font-size: 0.88rem;
  }
  .flow-step small {
    font-size: 0.72rem;
    color: #9fb3c4;
    margin-top: 0.15rem;
  }
  .flow-index {
    font:
      700 0.65rem ui-monospace,
      monospace;
    color: var(--cyan);
  }
  .flow-state {
    font:
      700 0.58rem ui-monospace,
      monospace;
    color: var(--cyan);
    text-align: right;
  }
  .flow-connector {
    height: 24px;
    width: 1px;
    background: var(--cyan);
    margin-left: 1.25rem;
  }
  .muted-connector {
    background: #61758a;
  }
  .flow-step.planned {
    opacity: 0.75;
    border-style: dashed;
  }
  .panel-foot {
    border-top: 1px solid #294056;
    margin-top: 1.2rem;
    padding-top: 1rem;
    color: var(--cyan);
  }
  .metrics-strip {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .metrics-grid > div {
    padding: 1.4rem 1.6rem;
    border-right: 1px solid var(--line);
  }
  .metrics-grid > div:first-child {
    padding-left: 0;
  }
