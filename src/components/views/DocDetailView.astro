---
import Layout from "../../layouts/Layout.astro";
import { render, type CollectionEntry } from "astro:content";
import { href, type Lang } from "../../lib/links";

interface Props {
  lang?: Lang;
  entry: CollectionEntry<"docs"> | CollectionEntry<"docsEn">;
  docs: Array<CollectionEntry<"docs"> | CollectionEntry<"docsEn">>;
}
const { lang = "vi", entry, docs } = Astro.props;
const isVi = lang === "vi";
const { Content, headings } = await render(entry);
const sorted = [...docs].sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  section="Docs"
  lang={lang}
  routePath={`docs/${entry.id}/`}
>
  <div class="container doc-top">
    <nav aria-label="Breadcrumb">
      <a href={href("", lang)}>{isVi ? "Trang chủ" : "Home"}</a><span>/</span><a
        href={href("docs/", lang)}>{isVi ? "Tài liệu" : "Documentation"}</a
      ><span>/</span><span aria-current="page">{entry.data.title}</span>
    </nav><span class="eyebrow"
      >{isVi ? "Hướng dẫn kỹ thuật" : "Technical guide"} /{" "}
      {String(entry.data.order).padStart(2, "0")}</span
    ><h1>{entry.data.title}</h1><p class="lede">{entry.data.description}</p>
  </div>
  <div class="container doc-grid">
    <aside
      class="docs-sidebar"
      aria-label={isVi ? "Danh mục hướng dẫn" : "Documentation guides"}
    >
      <strong>{isVi ? "Tài liệu" : "Documentation"}</strong>{
        sorted.map((doc) => (
          <a
            href={href(`docs/${doc.id}/`, lang)}
            aria-current={doc.id === entry.id ? "page" : undefined}
          >
            {doc.data.title}
          </a>
        ))
      }
    </aside><article class="prose">
      <Content /><div class="doc-end">
        <a href={href("docs/", lang)}
          >{isVi ? "← Tất cả tài liệu" : "← All documentation"}</a
        >
      </div>
    </article><aside
      class="toc"
      aria-label={isVi ? "Trên trang này" : "On this page"}
    >
      <strong>{isVi ? "Trên trang này" : "On this page"}</strong>{
        headings
          .filter((h) => h.depth === 2 || h.depth === 3)
          .map((h) => (
            <a class={h.depth === 3 ? "sub" : ""} href={`#${h.slug}`}>
              {h.text}
            </a>
          ))
      }
    </aside>
  </div>
</Layout>
<style>
  .doc-top {
    padding: 2rem 0 3rem;
    border-bottom: 1px solid var(--line);
  }
  .doc-top nav {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    color: var(--muted);
    font-size: 0.8rem;
    margin-bottom: 3rem;
  }
  .doc-top nav a {
    text-decoration: none;
  }
  .doc-top h1 {
    font-size: clamp(2.3rem, 5vw, 3.5rem);
    margin: 0.8rem 0;
  }
  .doc-top .lede {
    margin: 0;
  }
  .doc-grid {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr) 180px;
    gap: 3rem;
    padding-block: 3rem;
  }
  .docs-sidebar,
  .toc {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    align-self: start;
    position: sticky;
    top: 100px;
    font-size: 0.82rem;
  }
  .docs-sidebar {
    border-right: 1px solid var(--line);
    padding-right: 1.2rem;
  }
  .toc {
    border-left: 1px solid var(--line);
    padding-left: 1.2rem;
  }
  .docs-sidebar strong,
  .toc strong {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  .docs-sidebar a,
  .toc a {
    color: var(--muted);
    text-decoration: none;
    line-height: 1.3;
  }
  .docs-sidebar a:hover,
  .toc a:hover,
  .docs-sidebar a[aria-current="page"] {
    color: var(--cyan);
  }
  .toc .sub {
    padding-left: 0.7rem;
  }
  .prose {
    min-width: 0;
  }
  .doc-end {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 1100px) {
    .doc-grid {
      grid-template-columns: 190px minmax(0, 1fr);
    }
    .toc {
      display: none;
    }
  }
  @media (max-width: 700px) {
    .doc-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .docs-sidebar {
      position: static;
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: 0 0 1rem;
      display: flex;
      flex-direction: row;
      overflow-x: auto;
      white-space: nowrap;
    }
    .docs-sidebar strong {
      display: none;
    }
    .doc-top nav {
      margin-bottom: 2rem;
    }
  }
</style>
