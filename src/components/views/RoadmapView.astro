---
import Layout from "../../layouts/Layout.astro";
import PageIntro from "../../components/PageIntro.astro";
import { source, type Lang } from "../../lib/links";

interface Props {
  lang?: Lang;
}
const { lang = "vi" } = Astro.props;
const isVi = lang === "vi";

const milestones = isVi
  ? [
      [
        "M0–M1",
        "Hard Cutover v1 → v2 & Hợp đồng canonical-flow-v2-18",
        "Đã kiểm chứng thực nghiệm",
        "validated",
        "Chuyển toàn bộ v1 (NF-UNSW-NB15-v3) vào historical/nf_unsw_nb15_v3/ (0 fallback); xác minh AIT-NDS-v2 (3,464,400 dòng + 942 loại trừ), split tách biệt kịch bản v2-scenario-group-purged-v1 và TrainOnlyPreprocessor(asinh_robust, floor 0.25).",
        source("data/V2_SPLIT_MANIFEST.json"),
      ],
      [
        "M2 (RQ1/RQ2)",
        "4 mô hình E0, đa miền E1/E3b & phân loại 6 lớp",
        "Đã kiểm chứng thực nghiệm",
        "validated",
        "Đánh giá RF (F1=0.9950), XGBoost (0.9013), Autoencoder (0.5877), IF (0.5842) trên ait_test (N=988,805, RESEARCH_ONLY); E1 đa miền đạt CTU_Test F1=0.9564, Autoencoder_E3b giảm FPR xuống 13.79%, RF_multiclass đạt Macro-F1=0.7347; RQ2 ghi nhận h2_full_confirmed = false.",
        source("reports/experiments/ml/model_comparison_report.json"),
      ],
      [
        "M3 (RQ3/RQ4)",
        "Vector hành vi 16-D & Zero-day Holdout",
        "Đã kiểm chứng thực nghiệm",
        "validated",
        "RQ3: 16-D BehavioralVector (canonical-behavioral-v2-16) đạt F1=0.5556 trên mô phỏng và F1=0.7192 (> IP 0.6919) trên UWF-ZeekData24; liên kết log AIT bị chặn (#85). RQ4: IF Recall=0.9091, AE Recall=0.2045 trên 44 flow zero-day (unsupervised_ge_0_75_both = false).",
        source(
          "reports/experiments/behavioral/rq3_session_correlation_experiment.json",
        ),
      ],
      [
        "M4 (RQ5/RQ6)",
        "AES-256-GCM + DPAPI & Xoay khóa thích ứng",
        "Đã kiểm chứng thực nghiệm",
        "validated",
        "RQ5: Xoay khóa ở Risk >= 85.0 giảm 87.5% cửa sổ lộ khóa (1,200.0s → 150.01s) và 85.0% blast radius (40 → 6) với ResponsePolicy dry_run = True (executed = false). RQ6: AES-256-GCM đạt 72,177.2 ops/s (256B, P95 13.3 µs); process_batch(32) đạt 386.37 flow/s.",
        source("reports/experiments/crypto/rq5_rotation_experiment.json"),
      ],
      [
        "M5",
        "3 chế độ vận hành & Collector pure-Rust netflow-rs",
        "Đã triển khai / kiểm thử",
        "tested",
        "(1) Offline CSV (data/demo/demo_flows.csv, 200 flows, 4/4 REAL_MODELS, OOD=FITTED, 2x repeatability qua scripts/verify_clean_state_demo.py), (2) Dataset Replay (ait_test.csv.gz, batch 32, 399.44 flow/s), (3) Live Lab Monitoring (127.0.0.1 UDP NetFlow v9/IPFIX + telemetry/netflow-rs/ + LiveLogTailer).",
        source("reports/demo/clean_state_demo_verification.json"),
      ],
      [
        "M6.1–M6.5",
        "Tích hợp Desktop v2.0.0, FastAPI 0.1.0 & Kiểm toán tài liệu",
        "Đã triển khai / kiểm thử",
        "tested",
        "Tauri 2 + Svelte 5 Desktop 2.0.0, FastAPI 0.1.0 (33 OpenAPI paths / 35 operations), SQLite single-writer, 676 pytest + 41 Vitest + 11 desktop Rust + 6 netflow-rs Rust tests, cùng bộ luận văn/slide/QA bảo vệ v2.0.",
        source("docs/audits/PR156_HEAD_AUDIT_2026-11-19.md"),
      ],
      [
        "DEFERRED",
        "Lab phần cứng vật lý (#137) & Bộ cài Windows NSIS + Clean VM (#148)",
        "Đang hoãn (Deferred)",
        "progress",
        "Kiểm thử exporter router/switch vật lý (#137, real_device_tested = false) và đóng gói bộ cài Windows NSIS kèm kiểm thử E2E trên máy ảo Windows 10/11 sạch (#148) được giữ ở trạng thái DEFERRED.",
        source("docs/WINDOWS_INSTALLATION.md"),
      ],
      [
        "BLOCKED",
        "Bộ dữ liệu UGR'16 (HTTP 403) & Phát hành nhị phân công khai (#154)",
        "Bị chặn / Khóa quản trị",
        "progress",
        "Máy chủ UGR'16 trả về HTTP 403 (Portal en Mantenimiento); DISTRIBUTION_AUTHORIZATION.json giữ approved = false nên chưa phát hành binary công khai (#154).",
        source("reports/governance/DISTRIBUTION_AUTHORIZATION.json"),
      ],
    ]
  : [
      [
        "M0–M1",
        "Hard Cutover v1 → v2 & canonical-flow-v2-18 contract",
        "Experimentally validated",
        "validated",
        "Retired legacy v1 (NF-UNSW-NB15-v3) to historical/nf_unsw_nb15_v3/ (zero fallback); verified AIT-NDS-v2 (3,464,400 rows + 942 excluded), scenario-disjoint split v2-scenario-group-purged-v1 and TrainOnlyPreprocessor(asinh_robust, floor 0.25).",
        source("data/V2_SPLIT_MANIFEST.json"),
      ],
      [
        "M2 (RQ1/RQ2)",
        "4 E0 models, multi-domain E1/E3b & 6-class attribution",
        "Experimentally validated",
        "validated",
        "Evaluated RF (F1=0.9950), XGBoost (0.9013), Autoencoder (0.5877), IF (0.5842) on ait_test (N=988,805, RESEARCH_ONLY); multi-domain E1 reaches CTU_Test F1=0.9564, Autoencoder_E3b cuts FPR to 13.79%, RF_multiclass reaches Macro-F1=0.7347; RQ2 records h2_full_confirmed = false.",
        source("reports/experiments/ml/model_comparison_report.json"),
      ],
      [
        "M3 (RQ3/RQ4)",
        "16-D BehavioralVector & Zero-day Holdout",
        "Experimentally validated",
        "validated",
        "RQ3: 16-D BehavioralVector (canonical-behavioral-v2-16) reaches F1=0.5556 in simulation and F1=0.7192 (> IP 0.6919) on UWF-ZeekData24; AIT empirical log linkage is BLOCKED (#85). RQ4: IF Recall=0.9091, AE Recall=0.2045 on 44 zero-day flows (unsupervised_ge_0_75_both = false).",
        source(
          "reports/experiments/behavioral/rq3_session_correlation_experiment.json",
        ),
      ],
      [
        "M4 (RQ5/RQ6)",
        "AES-256-GCM + DPAPI & Adaptive Key Rotation",
        "Experimentally validated",
        "validated",
        "RQ5: Adaptive key rotation at Risk >= 85.0 cuts exposure window by 87.5% (1,200.0s → 150.01s) and blast radius by 85.0% (40 → 6) with ResponsePolicy dry_run = True (executed = false). RQ6: AES-256-GCM reaches 72,177.2 ops/s (256B, P95 13.3 µs); process_batch(32) reaches 386.37 flow/s.",
        source("reports/experiments/crypto/rq5_rotation_experiment.json"),
      ],
      [
        "M5",
        "3 operation modes & pure-Rust netflow-rs collector",
        "Implemented / tested",
        "tested",
        "(1) Offline CSV (data/demo/demo_flows.csv, 200 flows, 4/4 REAL_MODELS, OOD=FITTED, 2x repeatability via scripts/verify_clean_state_demo.py), (2) Dataset Replay (ait_test.csv.gz, batch 32, 399.44 flow/s), (3) Live Lab Monitoring (127.0.0.1 UDP NetFlow v9/IPFIX + telemetry/netflow-rs/ + LiveLogTailer).",
        source("reports/demo/clean_state_demo_verification.json"),
      ],
      [
        "M6.1–M6.5",
        "Desktop v2.0.0 integration, FastAPI 0.1.0 & thesis audit",
        "Implemented / tested",
        "tested",
        "Tauri 2 + Svelte 5 Desktop 2.0.0, FastAPI 0.1.0 (33 OpenAPI paths / 35 operations), single-writer SQLite, 676 pytest + 41 Vitest + 11 desktop Rust + 6 netflow-rs Rust tests, plus v2.0 thesis report, slides and defense Q&A.",
        source("docs/audits/PR156_HEAD_AUDIT_2026-11-19.md"),
      ],
      [
        "DEFERRED",
        "Physical router/switch lab (#137) & Windows NSIS + Clean VM (#148)",
        "Deferred",
        "progress",
        "Physical router/switch NetFlow exporter validation (#137, real_device_tested = false) and Windows NSIS installer packaging + clean Windows 10/11 VM E2E verification (#148) remain explicitly DEFERRED.",
        source("docs/WINDOWS_INSTALLATION.md"),
      ],
      [
        "BLOCKED",
        "UGR'16 corpus (HTTP 403) & Public Binary Release (#154)",
        "Blocked / Governance-locked",
        "progress",
        "Upstream UGR'16 remains HTTP 403 (Portal en Mantenimiento); DISTRIBUTION_AUTHORIZATION.json keeps approved = false, blocking public binary release (#154).",
        source("reports/governance/DISTRIBUTION_AUTHORIZATION.json"),
      ],
    ];
---

<Layout
  title={isVi ? "Lộ trình dự án" : "Roadmap"}
  description={isVi
    ? "Trạng thái các cột mốc M0–M6.7 của NetFlow Sentinel v2.0.0 và danh mục DEFERRED / BLOCKED."
    : "Evidence-driven milestone status for NetFlow Sentinel v2.0.0 (M0–M6.7) and DEFERRED / BLOCKED items."}
  section="Roadmap"
  lang={lang}
  routePath="roadmap/"
>
  <PageIntro
    eyebrow={isVi ? "07 / Lộ trình v2.0" : "07 / Roadmap v2.0"}
    current={isVi ? "Lộ trình" : "Roadmap"}
    title={isVi
      ? "Các cột mốc v2.0 thực tế, không tô hồng."
      : "v2.0 milestones, without the gloss."}
    description={isVi
      ? "Phân loại mức độ sẵn sàng hiện tại: Functional Prototype / Academic & Controlled Lab Pilot (RESEARCH_ONLY, approved = false). Bảng dưới đây tách bạch rõ các kết quả RQ1–RQ6 đã kiểm chứng với 4 hạng mục DEFERRED / BLOCKED."
      : "Current readiness classification: Functional Prototype / Academic & Controlled Lab Pilot (RESEARCH_ONLY, approved = false). The timeline below separates experimentally validated RQ1–RQ6 milestones from the four DEFERRED / BLOCKED items."}
    lang={lang}
  />
  <section class="section">
    <div class="container">
      <div class="roadmap-note callout">
        <strong>{isVi ? "Quy ước trạng thái:" : "Status key:"}</strong>{" "}
        {
          isVi
            ? "Experimentally validated = đã có lượt chạy dữ liệu thật kèm manifest SHA-256; Implemented / tested = đã có mã nguồn và vượt qua bộ test tự động (676 pytest, 41 Vitest, 17 Rust); Deferred / Blocked = hạng mục hoãn hoặc bị chặn đã được ghi nhận minh bạch trong kiểm toán phát hành."
            : "Experimentally validated = recorded real-data run with SHA-256 manifest; Implemented / tested = code and automated tests passing (676 pytest, 41 Vitest, 17 Rust); Deferred / Blocked = explicitly tracked non-blocking or governance-locked items."
        }
      </div><ol class="timeline">
        {
          milestones.map(([id, name, status, statusClass, detail, link]) => (
            <li>
              <>
                <span class="checkpoint">{id}</span>
                <div>
                  <>
                    <div class="timeline-head">
                      <>
                        <h2>{name}</h2>
                        <span class={`status status-${statusClass}`}>
                          {status}
                        </span>
                      </>
                    </div>
                    <p>{detail}</p>
                    <a class="source-link" href={link}>
                      {isVi ? "Xem bằng chứng ↗" : "Review evidence ↗"}
                    </a>
                  </>
                </div>
              </>
            </li>
          ))
        }
      </ol><p class="source-line">
        {isVi ? "Hồ sơ kiểm toán chuẩn: " : "Canonical audit record: "}<a
          href={source("docs/audits/V2_RELEASE_READINESS.md")}
          >{isVi ? "V2_RELEASE_READINESS.md ↗" : "V2_RELEASE_READINESS.md ↗"}</a
        > · <a href={source("reports/audits/V2_FINAL_AUDIT.md")}
          >{isVi ? "V2_FINAL_AUDIT.md ↗" : "V2_FINAL_AUDIT.md ↗"}</a
        > · <a href={source("docs/thesis/DEFENSE_QA_V2.md")}
          >{isVi ? "DEFENSE_QA_V2.md ↗" : "DEFENSE_QA_V2.md ↗"}</a
        >.
      </p>
    </div>
  </section>
</Layout>
<style>
  .roadmap-note {
    max-width: 900px;
  }
  .timeline {
    list-style: none;
    margin: 3rem 0;
    padding: 0;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 2rem;
    border-top: 1px solid var(--line);
    padding: 1.7rem 0;
  }
  .checkpoint {
    font:
      700 0.86rem ui-monospace,
      monospace;
    color: var(--cyan);
    padding-top: 0.4rem;
  }
  .timeline-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .timeline h2 {
    font-size: 1.25rem;
    margin: 0;
  }
  .timeline p {
    color: var(--muted);
    margin: 0.6rem 0;
  }
  .source-line {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .source-line a {
    color: var(--cyan);
  }
  @media (max-width: 700px) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
    .timeline-head {
      display: block;
    }
    .timeline-head .status {
      margin-top: 0.6rem;
    }
  }
</style>
