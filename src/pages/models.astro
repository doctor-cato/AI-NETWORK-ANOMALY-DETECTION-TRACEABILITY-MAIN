---
import Layout from "../layouts/Layout.astro";
import PageIntro from "../components/PageIntro.astro";
import { source } from "../lib/links";
const models = [
  {
    id: "random-forest",
    index: "01",
    name: "Random Forest",
    type: "Supervised · primary baseline",
    status: "Held-out Test verified",
    statusClass: "validated",
    principle:
      "An ensemble of decision trees votes on the binary flow label. It provides a strong, interpretable reference for later comparisons.",
    role: "Classify known benign versus attack flows under the 47-feature baseline contract.",
    input:
      "Inputs: 47 ordered NetFlow features; targets and six trace metadata fields are excluded.",
    method:
      "Canonical run: 200 trees, max depth 16, seed 42; chronological Train partition (1,655,797 rows), frozen train-only preprocessing, Validation and one-shot Held-out Test.",
    evaluation:
      "Validation F1 0.999869; Held-out Test (rf-heldout-ea330b9, 345,953 rows): F1 0.999853, Precision 0.999771, Recall 0.999935, FPR 0.000022 (TN=315,350, FP=7, FN=2, TP=30,594).",
    limit:
      "Feature importance and a shallow TTL-only diagnostic expose a strong testbed shortcut (MIN_TTL + MAX_TTL = 45.48%). Collapses on NF-CSE-CIC-IDS2018-v3 (Recall 0.0, FPR 0.3802). Binary .joblib stays outside Git.",
    link: source("reports/evaluation/error_analysis_report.md"),
  },
  {
    id: "xgboost",
    index: "02",
    name: "XGBoost",
    type: "Supervised · comparison baseline",
    status: "Held-out Test verified",
    statusClass: "validated",
    principle:
      "Gradient-boosted trees add models sequentially to reduce classification error on labelled flow data.",
    role: "Compare a second supervised learner with Random Forest under the same 47-feature contract and chronological split.",
    input: "Inputs: the same 47 ordered NetFlow features as Random Forest.",
    method:
      "Run xgb-baseline-1794755807: XGBClassifier (binary:logistic), 200 estimators, max depth 6, learning rate 0.1, subsample 0.8, colsample_bytree 0.8, tree_method hist, seed 42.",
    evaluation:
      "Validation F1 0.999984; Held-out Test (345,953 rows): F1 0.999984, Precision 0.999967, Recall 1.000000, FPR 0.000003, ROC-AUC 1.000000 (TN=315,356, FP=1, FN=0, TP=30,596).",
    limit:
      "Trained at commit 7f51390 with git_dirty=True prior to release commit; .joblib binary is outside Git (BLOCKED / NOT READY if missing locally). Same testbed TTL/overlap risks apply.",
    link: source("reports/evaluation/xgboost/evaluation_report.md"),
  },
  {
    id: "isolation-forest",
    index: "03",
    name: "Isolation Forest",
    type: "Unsupervised · anomaly score",
    status: "Held-out Test verified",
    statusClass: "validated",
    principle:
      "Random partitions isolate unusual observations quickly; shorter paths produce higher raw anomaly scores.",
    role: "Provide an anomaly-score detector fitted solely on benign flows without using attack labels for training.",
    input:
      "Inputs: 1,590,608 benign-only Train flows after frozen train-only preprocessing.",
    method:
      "Run if-c4-20261115T055359Z (clean commit bf0f3ec, 100 trees, contamination 0.1, seed 42). Threshold -0.033527 selected on Validation via max-F1-on-known-attacks with Backdoor & Worms held out.",
    evaluation:
      "Held-out Test (345,953 rows): F1 0.5064, Precision 0.3523, Recall 0.8997, FPR 0.1605, ROC-AUC 0.893730. Unknown holdout {Backdoor, Worms}: Recall 0.8657 (1,122 / 1,296).",
    limit:
      "High false-positive rate (16.05%) on benign Test flows; emits raw_anomaly_score (attack_probability is null). Binary .joblib stays outside Git.",
    link: source("reports/experiments/isolation_forest/evaluation_report.md"),
  },
  {
    id: "autoencoder",
    index: "04",
    name: "Autoencoder",
    type: "Unsupervised · reconstruction error",
    status: "Held-out Test verified",
    statusClass: "validated",
    principle:
      "A symmetric neural encoder-decoder (47 → 32 → 16 → 32 → 47) reconstructs benign inputs; larger MSE reconstruction error flags anomalous flows.",
    role: "Compare reconstruction-error anomaly detection against Isolation Forest under a strict Validation false-positive budget.",
    input:
      "Inputs: 1,590,608 benign-only Train flows after frozen train-only preprocessing.",
    method:
      "Active run ae_fpr_constrained_20261115T163000Z: ReLU + Adam, threshold 17234985.792476 frozen on Validation via fpr_constrained (target FPR ≤ 0.05; empirical Val FPR 0.0500), isolating Backdoor & Worms.",
    evaluation:
      "Held-out Test (345,953 rows): F1 0.1361, Precision 0.1804, Recall 0.1093, FPR 0.0482, ROC-AUC 0.6303, PR-AUC 0.1615. Unknown holdout {Backdoor, Worms}: Recall 0.0625 (81 / 1,296).",
    limit:
      "Low recall under the FPR ≤ 0.05 constraint; earlier ae_benign_quantile run archived separately in runs/. Binary .joblib stays outside Git (fail-closed HTTP 503 if missing).",
    link: source("reports/evaluation/autoencoder/evaluation_report.md"),
  },
];
---

<Layout
  title="AI Models"
  description="Four model families and their real-data Validation and Held-out Test status."
  section="Models"
>
  <PageIntro
    eyebrow="03 / Model methods"
    current="AI Models"
    title="Four approaches. One evidence standard."
    description="Each model has a distinct learning mechanism, threshold protocol and output semantic. All four families now have recorded Train, Validation and Held-out Test evidence on NF-UNSW-NB15-v3."
  />
  <div class="container model-nav">
    <span>JUMP TO MODEL</span>{
      models.map((m) => (
        <a href={`#${m.id}`}>
          {m.index} {m.name}
        </a>
      ))
    }
  </div>
  {
    models.map((m) => (
      <section id={m.id} class="section model-section rule">
        <div class="container model-layout">
          <>
            <div>
              <>
                <span class="eyebrow">
                  {m.index} / {m.type}
                </span>
                <h2>{m.name}</h2>
                <span class={`status status-${m.statusClass}`}>{m.status}</span>
                <p class="lede principle">{m.principle}</p>
                <a class="source-link" href={m.link}>
                  Inspect source evidence ↗
                </a>
              </>
            </div>
            <div class="detail-grid">
              <>
                <div>
                  <>
                    <h3>Expected role</h3>
                    <p>{m.role}</p>
                  </>
                </div>
                <div>
                  <>
                    <h3>Inputs & training</h3>
                    <p>
                      {m.input} {m.method}
                    </p>
                  </>
                </div>
                <div>
                  <>
                    <h3>Evaluation</h3>
                    <p>{m.evaluation}</p>
                  </>
                </div>
                <div>
                  <>
                    <h3>Limitation</h3>
                    <p>{m.limit}</p>
                  </>
                </div>
              </>
            </div>
          </>
        </div>
      </section>
    ))
  }
  <div class="container section">
    <div class="callout">
      <strong>Shared boundary:</strong> The raw CSV has 55 columns. The baseline uses
      47 model features, with six trace metadata fields and both targets excluded.
      Supervised models emit <code>attack_probability</code> in [0, 1]; unsupervised
      detectors emit unclamped <code>raw_anomaly_score</code> (and Validation-calibrated
      <code>normalized_anomaly_score</code>) with
      <code>attack_probability = null</code>. Missing local <code>.joblib</code>
      artifacts fail closed as <code>BLOCKED / NOT READY</code> (HTTP 503).
    </div>
  </div>
</Layout>
<style>
  .model-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.4rem;
    padding-bottom: 1.4rem;
  }
  .model-nav span {
    font:
      700 0.68rem ui-monospace,
      monospace;
    color: var(--muted);
    letter-spacing: 0.1em;
    margin-right: 1rem;
  }
  .model-nav a {
    font-size: 0.8rem;
    color: var(--cyan);
  }
  .model-section {
    scroll-margin-top: 80px;
  }
  .model-section:nth-of-type(even) {
    background: var(--surface);
  }
  .model-layout {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: 5rem;
  }
  .model-layout > div {
    min-width: 0;
  }
  .model-layout h2 {
    margin: 0.8rem 0;
  }
  .principle {
    margin: 2rem 0 1rem;
  }
  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2rem;
  }
  .detail-grid > div {
    min-width: 0;
    border-top: 1px solid var(--line);
    padding-top: 0.8rem;
  }
  .detail-grid h3 {
    font-size: 0.95rem;
    margin: 0.2rem 0;
  }
  .detail-grid p,
  .callout {
    overflow-wrap: anywhere;
  }
  .detail-grid p {
    color: var(--muted);
    font-size: 0.88rem;
    margin: 0.4rem 0;
  }
  @media (max-width: 800px) {
    .model-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
  @media (max-width: 550px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
