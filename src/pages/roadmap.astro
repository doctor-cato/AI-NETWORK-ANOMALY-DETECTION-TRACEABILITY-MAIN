---
import Layout from "../layouts/Layout.astro";
import PageIntro from "../components/PageIntro.astro";
import { issue, source } from "../lib/links";
const milestones = [
  [
    "C0–C2",
    "Governance, data quality, split & preprocessing",
    "Experimentally validated",
    "validated",
    "Verified 2,365,424-row package, EDA, chronological split with purge gaps and train-only preprocessor; historical vs newer split index parity remains unverified.",
    source("reports/splits/nf_unsw_nb15_v3_split_manifest.json"),
  ],
  [
    "C3",
    "Supervised models (RF & XGBoost)",
    "Experimentally validated",
    "validated",
    "Random Forest (rf-heldout-ea330b9, F1 0.999853) and XGBoost (xgb-baseline-1794755807, F1 0.999984) validated on both Validation and Held-out Test.",
    source("reports/evaluation/error_analysis_report.md"),
  ],
  [
    "C4",
    "Unsupervised models (IF & Autoencoder)",
    "Experimentally validated",
    "validated",
    "Isolation Forest (if-c4-20261115T055359Z, Test F1 0.5064, Unknown 0.8657) and Autoencoder (ae_fpr_constrained_20261115T163000Z, Val FPR 0.0500, Test F1 0.1361) verified.",
    source("reports/evaluation/autoencoder/evaluation_report.md"),
  ],
  [
    "C5–C6",
    "Behavioral summary, risk & timeline (Scoped M6)",
    "Implemented / tested",
    "tested",
    "Reduced from full auth/API correlation to NetFlow metadata summaries (#28), deterministic priority scoring (#32) and deterministic timelines (#24) with OOD abstention.",
    source("docs/ARCHITECTURE.md"),
  ],
  [
    "C7",
    "Security posture & key lifecycle",
    "Scoped / deferred",
    "progress",
    "Loopback 127.0.0.1 binding, 256-bit session token, SHA-256 artifact gate and SQLite audit metadata implemented; production AES-256-GCM OS keyring rotation deferred (#26).",
    source("reports/api/API_CONTRACT.md"),
  ],
  [
    "C8",
    "Adaptive security response dry-run",
    "Implemented / tested",
    "tested",
    "Deterministic policy engine & key-rotation dry-run (#27, executed=false) gated on server-verified analysis with Tab 4 + SQLite + JSON export; live firewall actions deferred.",
    source("docs/releases/v0.6.0.md"),
  ],
  [
    "C9",
    "FastAPI, SQLite, ingestion gate & Desktop UI",
    "Implemented / tested",
    "tested",
    "18 FastAPI endpoints, SQLite persistence, multi-source OOD gate (#46) and Tauri 2 + Svelte 5 desktop app (v0.6.0 Windows NSIS) verified with 4-model E2E attestation.",
    source("reports/releases/v0.6.0_e2e_verification.json"),
  ],
  [
    "C10–C11",
    "Cross-dataset research & final delivery",
    "In progress",
    "progress",
    "Cross-dataset RF evaluation on NF-CSE-CIC-IDS2018-v3 documented (Recall 0.0, FPR 0.3802); final academic report, slides (#18–#20) and GitHub Release publication remaining.",
    issue(25),
  ],
];
---

<Layout
  title="Roadmap"
  description="Evidence-driven checkpoint status for M0–M7 and consolidated v0.6.0 delivery."
  section="Roadmap"
>
  <PageIntro
    eyebrow="07 / Roadmap"
    current="Roadmap"
    title="Milestones, without the gloss."
    description="A checkpoint name is a research target, not proof of completion. Statuses below distinguish experimentally validated models from scoped or deferred system layers on main."
  />
  <section class="section">
    <div class="container">
      <div class="roadmap-note callout">
        <strong>Status key:</strong> Planned = design only; In progress = partial
        implementation or open PR; Implemented = code on main; Tested = automated
        behavior checks; Experimentally validated = a recorded real-data run. A checkpoint
        can contain work at several levels.
      </div><ol class="timeline">
        {
          milestones.map(([id, name, status, statusClass, detail, link]) => (
            <li>
              <>
                <span class="checkpoint">{id}</span>
                <div>
                  <>
                    <div class="timeline-head">
                      <>
                        <h2>{name}</h2>
                        <span class={`status status-${statusClass}`}>
                          {status}
                        </span>
                      </>
                    </div>
                    <p>{detail}</p>
                    <a class="source-link" href={link}>
                      Review evidence ↗
                    </a>
                  </>
                </div>
              </>
            </li>
          ))
        }
      </ol><p class="source-line">
        Canonical scope: <a href={source("docs/ROADMAP_FULL_SYSTEM.md")}
          >full-system roadmap ↗</a
        > · <a href={source("docs/IMPLEMENTATION_CHECKPOINTS.md")}
          >implementation checkpoints ↗</a
        >. Issue closure alone does not establish an experiment result.
      </p>
    </div>
  </section>
</Layout>
<style>
  .roadmap-note {
    max-width: 900px;
  }
  .timeline {
    list-style: none;
    margin: 3rem 0;
    padding: 0;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 2rem;
    border-top: 1px solid var(--line);
    padding: 1.7rem 0;
  }
  .checkpoint {
    font:
      700 0.86rem ui-monospace,
      monospace;
    color: var(--cyan);
    padding-top: 0.4rem;
  }
  .timeline-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .timeline h2 {
    font-size: 1.25rem;
    margin: 0;
  }
  .timeline p {
    color: var(--muted);
    margin: 0.6rem 0;
  }
  .source-line {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .source-line a {
    color: var(--cyan);
  }
  @media (max-width: 700px) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
    .timeline-head {
      display: block;
    }
    .timeline-head .status {
      margin-top: 0.6rem;
    }
  }
</style>
