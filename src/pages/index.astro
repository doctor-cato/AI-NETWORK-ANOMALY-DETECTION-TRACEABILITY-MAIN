---
import Layout from "../layouts/Layout.astro";
import { href, repository, source } from "../lib/links";
---

<Layout
  title="Home"
  description="Evidence-led research into network-flow anomaly detection, model validity and traceability."
>
  <section class="hero grid-lines">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Open research · NF-UNSW-NB15-v3</span>
        <h1>Detect the anomaly.<br /><em>Trace the evidence.</em></h1>
        <p class="lede">
          A research prototype studying how network-flow classifiers, anomaly
          detectors and traceable evidence can support security analysis. This
          portal separates measured results from planned system capabilities.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={href("results/")}
            >Explore the evidence <span aria-hidden="true">↗</span></a
          ><a class="button" href={repository}
            >View repository <span aria-hidden="true">↗</span></a
          >
        </div>
        <div class="hero-note">
          <span class="status status-progress">Research in progress</span><span
            >Static documentation portal · no live traffic or inference</span
          >
        </div>
      </div>
      <div
        class="signal-panel"
        role="img"
        aria-label="Research pipeline: verified dataset and preprocessing feed four validated models, localhost FastAPI, Tauri desktop UI and dry-run response"
      >
        <div class="panel-top">
          <span>RESEARCH PIPELINE / 002</span><span
            class="panel-dots"
            aria-hidden="true">● ● ●</span
          >
        </div>
        <div class="flow-step">
          <span class="flow-index">01</span><div>
            <strong>NF-UNSW-NB15-v3</strong><small
              >Verified source · 2,365,424 flow records</small
            >
          </div><span class="flow-state">VERIFIED</span>
        </div>
        <div class="flow-connector" aria-hidden="true"></div>
        <div class="flow-step">
          <span class="flow-index">02</span><div>
            <strong>Split, OOD gate & preprocessing</strong><small
              >47-feature baseline contract · train-only fit</small
            >
          </div><span class="flow-state">IMPLEMENTED</span>
        </div>
        <div class="flow-connector" aria-hidden="true"></div>
        <div class="flow-step">
          <span class="flow-index">03</span><div>
            <strong>Four validated model families</strong><small
              >RF · XGBoost · Isolation Forest · Autoencoder</small
            >
          </div><span class="flow-state">VALIDATED</span>
        </div>
        <div class="flow-connector muted-connector" aria-hidden="true"></div>
        <div class="flow-step planned">
          <span class="flow-index">04</span><div>
            <strong>Desktop UI, trace & dry-run (v0.6.0)</strong><small
              >Tauri 2 + FastAPI · live firewall & AES keyring deferred</small
            >
          </div><span class="flow-state">SCOPED M6</span>
        </div>
        <div class="panel-foot">
          <span>IN-DOMAIN TEST ≠ EXTERNAL GENERALIZATION</span><span>↗</span>
        </div>
      </div>
    </div>
  </section>

  <section class="metrics-strip rule">
    <div class="container metrics-grid">
      <div><strong>2.36M</strong><span>verified flow rows</span></div><div>
        <strong>47</strong><span>baseline ML features</span>
      </div><div>
        <strong>4</strong><span>validated models (Train / Val / Test)</span>
      </div><div>
        <strong>18</strong><span>FastAPI endpoints (v0.6.0 local UI)</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-heading">
      <div>
        <span class="eyebrow">Research question</span><h2>
          What does the model learn?
        </h2>
      </div><div>
        <p class="lede">
          Network anomaly detection identifies flows whose patterns diverge from
          expected or labelled behavior. The project asks whether strong
          benchmark scores survive stricter checks for duplicate vectors,
          testbed shortcuts and changing traffic distributions.
        </p><a class="text-link" href={href("research/")}
          >Read the research scope <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </section>

  <section class="section tinted rule">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Investigation tracks</span><h2>
          Four model families, different evidence levels.
        </h2><p>
          Two supervised baselines and two anomaly-score approaches have
          separate training and evaluation protocols.
        </p>
      </div><div class="model-grid">
        <a class="model-card" href={href("models/#random-forest")}
          ><span class="model-number">01 / SUPERVISED</span><h3>
            Random Forest
          </h3><p>
            Primary binary baseline. Held-out Test F1 0.999853, diagnostic TTL
            audit and cross-dataset collapse documented.
          </p><span class="status status-validated">Held-out Test verified</span
          ></a
        >
        <a class="model-card" href={href("models/#xgboost")}
          ><span class="model-number">02 / SUPERVISED</span><h3>XGBoost</h3><p>
            Comparison baseline. Validation and Held-out Test both reach F1
            0.999984; `.joblib` binary stays outside Git.
          </p><span class="status status-validated">Held-out Test verified</span
          ></a
        >
        <a class="model-card" href={href("models/#isolation-forest")}
          ><span class="model-number">03 / UNSUPERVISED</span><h3>
            Isolation Forest
          </h3><p>
            Benign-only training and Validation calibration (-0.033527). Test F1
            0.5064, Recall 0.8997, Unknown Recall 0.8657.
          </p><span class="status status-validated">Held-out Test verified</span
          ></a
        >
        <a class="model-card" href={href("models/#autoencoder")}
          ><span class="model-number">04 / UNSUPERVISED</span><h3>
            Autoencoder
          </h3><p>
            Benign-only reconstruction error under Validation FPR ≤ 0.05.
            Held-out Test F1 0.1361, Recall 0.1093, Unknown 0.0625.
          </p><span class="status status-validated">Held-out Test verified</span
          ></a
        >
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container evidence-grid">
      <div>
        <span class="eyebrow">Current evidence</span><h2>
          Progress is visible.<br />So are the limits.
        </h2><p class="lede">
          All four models now have recorded Train, Validation and Held-out Test
          evidence on NF-UNSW-NB15-v3, alongside a Tauri 2 + FastAPI desktop
          prototype (`v0.6.0`). Cross-dataset testing still exposes severe
          domain collapse.
        </p><a class="button" href={href("roadmap/")}>View milestone status ↗</a
        >
      </div><div class="evidence-list">
        <div>
          <span>01</span><p>
            <strong>Held-out Test completed across 4 models</strong><br />Random
            Forest, XGBoost, Isolation Forest and Autoencoder are all evaluated
            on the 345,953-row Test partition.
          </p>
        </div><div>
          <span>02</span><p>
            <strong>Cross-dataset failure is measured</strong><br />On a
            100,000-row `NF-CSE-CIC-IDS2018-v3` sample, RF drops to 0.0000
            Recall and 0.3802 FPR due to `MIN_TTL` drift.
          </p>
        </div><div>
          <span>03</span><p>
            <strong>Scoped desktop & dry-run boundaries</strong><br />Tauri 2 +
            Svelte 5 + FastAPI (`127.0.0.1`) runs OOD gating and dry-run policy
            checks; live firewall actions and AES-GCM keyring remain deferred.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section closing rule">
    <div class="container">
      <span class="eyebrow">Start with the record</span><h2>
        Follow each claim to its source.
      </h2><p>
        Read the methods, inspect the four-model Held-out Test results, then
        examine the underlying repository artifacts.
      </p><div class="hero-actions">
        <a class="button button-primary" href={href("docs/")}
          >Browse documentation ↗</a
        ><a
          class="button"
          href={source("reports/evaluation/error_analysis_report.md")}
          >Inspect Test error analysis ↗</a
        >
      </div>
    </div>
  </section>
</Layout>
<style>
  .hero {
    padding: 5.4rem 0 5.8rem;
    position: relative;
    overflow: hidden;
  }
  .hero:before {
    content: "";
    position: absolute;
    width: 600px;
    height: 600px;
    right: -100px;
    top: -300px;
    background: radial-gradient(circle, #26698038, transparent 70%);
    pointer-events: none;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: center;
    position: relative;
  }
  .hero h1 {
    margin: 1.2rem 0 1.4rem;
    max-width: 13ch;
  }
  .hero h1 em {
    font-style: normal;
    color: var(--cyan);
  }
  .hero .lede {
    max-width: 54ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }
  .hero-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 3rem;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .signal-panel {
    background: linear-gradient(145deg, var(--surface), #0a192b);
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    box-shadow: var(--shadow);
    padding: 1.3rem;
    color: #eaf5fa;
  }
  .panel-top,
  .panel-foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font:
      700 0.65rem/1.3 ui-monospace,
      SFMono-Regular,
      monospace;
    letter-spacing: 0.1em;
    color: #86a9ba;
  }
  .panel-top {
    padding-bottom: 1.2rem;
    border-bottom: 1px solid #294056;
  }
  .panel-dots {
    color: var(--cyan);
    letter-spacing: 0.4em;
  }
  .flow-step {
    display: flex;
    align-items: center;
    gap: 1rem;
    border: 1px solid #375269;
    background: #12273a;
    padding: 1rem 0.8rem;
    border-radius: 0.25rem;
  }
  .flow-step > div {
    flex: 1;
    min-width: 0;
  }
  .flow-step strong,
  .flow-step small {
    display: block;
  }
  .flow-step strong {
    font-size: 0.88rem;
  }
  .flow-step small {
    font-size: 0.72rem;
    color: #9fb3c4;
    margin-top: 0.15rem;
  }
  .flow-index {
    font:
      700 0.65rem ui-monospace,
      monospace;
    color: var(--cyan);
  }
  .flow-state {
    font:
      700 0.58rem ui-monospace,
      monospace;
    color: var(--cyan);
  }
  .flow-connector {
    height: 24px;
    width: 1px;
    background: var(--cyan);
    margin-left: 1.25rem;
  }
  .muted-connector {
    background: #61758a;
  }
  .flow-step.planned {
    opacity: 0.65;
    border-style: dashed;
  }
  .panel-foot {
    border-top: 1px solid #294056;
    margin-top: 1.2rem;
    padding-top: 1rem;
    color: var(--cyan);
  }
  .metrics-strip {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .metrics-grid > div {
    padding: 1.4rem 1.6rem;
    border-right: 1px solid var(--line);
  }
  .metrics-grid > div:first-child {
    padding-left: 0;
  }
  .metrics-grid > div:last-child {
    border: 0;
  }
  .metrics-grid strong {
    display: block;
    color: var(--text);
    font-size: 1.85rem;
    line-height: 1.2;
    letter-spacing: -0.05em;
  }
  .metrics-grid span {
    display: block;
    color: var(--muted);
    font-size: 0.75rem;
    margin-top: 0.4rem;
  }
  .split-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
  }
  .split-heading h2 {
    max-width: 12ch;
    margin: 0.8rem 0 0;
  }
  .text-link {
    display: inline-block;
    color: var(--cyan);
    font-weight: 700;
    margin-top: 0.5rem;
  }
  .tinted {
    background: var(--surface);
  }
  .section-heading {
    max-width: 650px;
    margin-bottom: 2rem;
  }
  .section-heading h2 {
    margin: 0.7rem 0;
  }
  .section-heading p {
    color: var(--muted);
  }
  .model-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .model-card {
    border: 1px solid var(--line);
    padding: 1.45rem;
    background: var(--bg);
    border-radius: 0.35rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    min-height: 275px;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .model-card:hover {
    border-color: var(--cyan);
    transform: translateY(-3px);
  }
  .model-number {
    color: var(--cyan);
    font:
      700 0.7rem ui-monospace,
      monospace;
    letter-spacing: 0.08em;
  }
  .model-card h3 {
    margin: 1.7rem 0 0.5rem;
  }
  .model-card p {
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.6;
    flex: 1;
  }
  .evidence-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
  }
  .evidence-grid h2 {
    margin: 0.7rem 0;
  }
  .evidence-grid .button {
    margin-top: 1rem;
  }
  .evidence-list > div {
    display: flex;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .evidence-list > div:first-child {
    border-top: 1px solid var(--line);
  }
  .evidence-list span {
    color: var(--cyan);
    font:
      700 0.75rem ui-monospace,
      monospace;
    padding-top: 0.25rem;
  }
  .evidence-list p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .evidence-list strong {
    color: var(--text);
  }
  .closing {
    background: var(--surface-2);
  }
  .closing h2 {
    margin: 0.8rem 0;
  }
  .closing p {
    color: var(--muted);
  }
  @media (max-width: 1000px) {
    .hero-grid {
      gap: 2rem;
    }
    .model-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 760px) {
    .hero {
      padding: 3.5rem 0;
    }
    .hero-grid,
    .split-heading,
    .evidence-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .hero h1 {
      font-size: clamp(2.6rem, 10vw, 4rem);
    }
    .hero-note {
      margin-top: 2rem;
    }
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .metrics-grid > div {
      padding: 1rem !important;
      border-bottom: 1px solid var(--line);
    }
    .model-grid {
      grid-template-columns: 1fr;
    }
    .model-card {
      min-height: auto;
    }
    .model-card h3 {
      margin: 1rem 0 0.2rem;
    }
  }
</style>
