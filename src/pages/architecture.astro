---
import Layout from "../layouts/Layout.astro";
import PageIntro from "../components/PageIntro.astro";
import { source } from "../lib/links";
const layers = [
  [
    "Data acquisition & validation",
    "Tested & verified",
    "Official-source fetcher, manifest, streaming quality checks, EDA and Validation-only demo prep are on main.",
    source("docs/dataset/NF_UNSW_NB15_V3_PROVENANCE.md"),
  ],
  [
    "Split, preprocessing & OOD gate",
    "Implemented & tested",
    "Chronological split, TrainOnlyPreprocessor, 4-tier compatibility evaluator, provenance trust anchor and ABSTAINED_OOD gate.",
    source("docs/MULTI_SOURCE_INGESTION.md"),
  ],
  [
    "Four verified ML models",
    "Held-out Test verified",
    "Random Forest, XGBoost, Isolation Forest and Autoencoder all evaluated on Train/Val/Test; .joblib binaries stay outside Git.",
    source("reports/evaluation/error_analysis_report.md"),
  ],
  [
    "Behavioral, risk & timeline",
    "Implemented (scoped M6)",
    "NetFlow metadata stats (#28), deterministic 0–100 priority (#32) and deterministic timeline (#24); no Auth/API logs.",
    source("docs/ARCHITECTURE.md"),
  ],
  [
    "Adaptive response dry-run (#27)",
    "Implemented (Dry-Run)",
    "Deterministic policy engine and rotation simulation (executed=false) gated on server-verified analysis; live OS firewall & AES keyring deferred.",
    source("reports/api/API_CONTRACT.md"),
  ],
  [
    "FastAPI (127.0.0.1) & SQLite",
    "Implemented & tested",
    "18 localhost REST endpoints, 256-bit X-Sentinel-Session-Token auth, single-writer SQLite persistence and SHA-256 export metadata.",
    source("reports/api/openapi.json"),
  ],
  [
    "Desktop UI (Tauri 2 + Svelte 5)",
    "Implemented (v0.6.0)",
    "Windows x64 NSIS installer, Python process lifecycle and Companion Bundle onboarding; requires external Python >= 3.12 + WebView2.",
    source("docs/WINDOWS_INSTALLATION.md"),
  ],
  [
    "Live OS blocking & embedded Python",
    "Deferred",
    "Live firewall automation, production AES-256-GCM OS keyring rotation, live PCAP capture and embedded Python runtime remain deferred.",
    source("docs/releases/v0.6.0.md"),
  ],
];
---

<Layout
  title="System Architecture"
  description="Consolidated M6 architecture (Tauri 2 + Svelte 5 + FastAPI + SQLite) and layer boundaries."
  section="Architecture"
>
  <PageIntro
    eyebrow="05 / Architecture"
    current="Architecture"
    title="A local desktop system with explicit boundaries."
    description="The consolidated v0.6.0 architecture connects verified NetFlow data through OOD gating, four validated models, localhost FastAPI + SQLite and a Tauri 2 + Svelte 5 desktop UI. Solid nodes are implemented on main; dashed nodes are deferred."
  />
  <section class="section">
    <div class="container">
      <div class="diagram-head">
        <div>
          <span class="eyebrow">Consolidated MVP (v0.6.0)</span><h2>
            From flow record to desktop evidence trail.
          </h2>
        </div><div class="diagram-legend">
          <span><i></i> Implemented on main</span><span
            ><i></i> Deferred / external</span
          >
        </div>
      </div><div class="diagram-wrap surface">
        <svg
          role="img"
          aria-labelledby="diagram-title diagram-desc"
          viewBox="0 0 1040 610"
          xmlns="http://www.w3.org/2000/svg"
          ><title id="diagram-title">
            Consolidated network anomaly detection desktop architecture
          </title><desc id="diagram-desc"
            >Verified NetFlow acquisition and OOD gating feed train-only
            preprocessing, four validated models, deterministic
            risk/timeline/dry-run layers, SQLite-backed FastAPI on 127.0.0.1 and
            the Tauri 2 + Svelte 5 desktop app. Live firewall automation and
            AES-256-GCM OS keyring remain deferred.</desc
          ><defs
            ><marker
              id="arrow"
              markerWidth="8"
              markerHeight="8"
              refX="7"
              refY="4"
              orient="auto"
              ><path d="M0 0 L8 4 L0 8" fill="#66e1e8"></path></marker
            ></defs
          >
          <g
            fill="none"
            stroke="#66e1e8"
            stroke-width="2"
            marker-end="url(#arrow)"
            ><path d="M235 100H305"></path><path d="M495 100H565"></path><path
              d="M755 100H825"></path><path d="M920 145V230"></path><path
              d="M825 270H755"></path><path d="M565 270H495"></path><path
              d="M400 310V390"></path><path d="M495 435H565"></path></g
          >
          <g fill="#132b3d" stroke="#66e1e8" stroke-width="2"
            ><rect x="25" y="55" width="210" height="90" rx="5"></rect><rect
              x="305"
              y="55"
              width="190"
              height="90"
              rx="5"></rect><rect x="565" y="55" width="190" height="90" rx="5"
            ></rect><rect x="825" y="55" width="190" height="90" rx="5"
            ></rect><rect x="565" y="230" width="190" height="80" rx="5"
            ></rect><rect x="305" y="230" width="190" height="80" rx="5"
            ></rect><rect x="305" y="390" width="190" height="90" rx="5"
            ></rect></g
          >
          <g
            fill="#152334"
            stroke="#778ca0"
            stroke-width="2"
            stroke-dasharray="7 6"
            ><rect x="565" y="390" width="240" height="90" rx="5"></rect><rect
              x="25"
              y="390"
              width="210"
              height="90"
              rx="5"></rect></g
          >
          <g
            font-family="ui-sans-serif,system-ui"
            fill="#e8f6f8"
            font-size="17"
            font-weight="700"
            ><text x="45" y="91">Acquire + OOD gate</text><text x="325" y="91"
              >Preprocess</text
            ><text x="585" y="91">RF / XGBoost</text><text x="845" y="91"
              >IF / Autoencoder</text
            ><text x="585" y="265">Risk + Timeline</text><text x="325" y="265"
              >FastAPI + SQLite</text
            ><text x="325" y="425">Tauri 2 + Svelte 5</text><text
              x="585"
              y="425">Live OS Actions</text
            ><text x="45" y="425">Embedded Python</text></g
          >
          <g font-family="ui-sans-serif,system-ui" fill="#9fb3c4" font-size="12"
            ><text x="45" y="119">provenance & ABSTAINED_OOD</text><text
              x="325"
              y="119">train-only SHA-256</text
            ><text x="585" y="119">Test F1 0.9999 / 1.0000</text><text
              x="845"
              y="119">Test F1 0.5064 / 0.1361</text
            ><text x="585" y="290">Dry-run #27 (executed=false)</text><text
              x="325"
              y="290">127.0.0.1 + token auth</text
            ><text x="325" y="452">Windows NSIS v0.6.0</text><text
              x="585"
              y="452">firewall & AES keyring deferred</text
            ><text x="45" y="452">external Python 3.12+ & bundle</text></g
          ></svg
        >
      </div><p class="diagram-note">
        NF-UNSW-NB15-v3 contains NetFlow fields, not API, authentication or
        application-session events. Behavioral summaries (#28) use NetFlow
        metadata only and include an explicit non-attribution notice.
      </p>
    </div>
  </section>
  <section class="section rule tinted">
    <div class="container">
      <span class="eyebrow">Implementation inventory</span><h2>
        What each layer can claim today.
      </h2><div class="table-wrap">
        <table class="data-table">
          <caption class="sr-only"
            >Architecture layers, implementation status and evidence</caption
          ><thead
            ><tr
              ><th scope="col">Layer</th><th scope="col">Current status</th><th
                scope="col">Evidence boundary</th
              ><th scope="col">Source</th></tr
            ></thead
          ><tbody
            >{
              layers.map(([name, status, note, link]) => (
                <tr>
                  <>
                    <th scope="row">{name}</th>
                    <td>{status}</td>
                    <td>{note}</td>
                    <td>
                      <a href={link}>Inspect ↗</a>
                    </td>
                  </>
                </tr>
              ))
            }</tbody
          >
        </table>
      </div>
    </div>
  </section>
</Layout>
<style>
  .diagram-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }
  .diagram-head h2 {
    margin: 0.6rem 0 1.5rem;
  }
  .diagram-legend {
    display: flex;
    gap: 1.4rem;
    color: var(--muted);
    font-size: 0.78rem;
    margin-bottom: 1.5rem;
  }
  .diagram-legend span {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  .diagram-legend i {
    display: block;
    width: 12px;
    height: 12px;
    border: 2px solid var(--cyan);
  }
  .diagram-legend span:last-child i {
    border-color: var(--muted);
    border-style: dashed;
  }
  .diagram-wrap {
    overflow: auto;
    padding: 1.5rem;
    background: #0b1929;
  }
  .diagram-wrap svg {
    display: block;
    min-width: 700px;
    width: 100%;
    height: auto;
  }
  .diagram-note {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .tinted {
    background: var(--surface);
  }
  .data-table a {
    color: var(--cyan);
  }
  .data-table td {
    color: var(--muted);
  }
  @media (max-width: 700px) {
    .diagram-head {
      display: block;
    }
    .diagram-legend {
      flex-wrap: wrap;
    }
  }
</style>
