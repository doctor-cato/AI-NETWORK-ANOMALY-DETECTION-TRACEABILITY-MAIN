---
import "../styles/global.css";
import { evidenceCommit, href, repository, type Lang } from "../lib/links";

interface Props {
  title: string;
  description: string;
  section?: string;
  lang?: Lang;
  routePath?: string;
}
const {
  title,
  description,
  section,
  lang = "vi",
  routePath = "",
} = Astro.props;
const isVi = lang === "vi";
const nav = isVi
  ? [
      ["Nghiên cứu", "research/", "Research"],
      ["Dữ liệu", "dataset/", "Dataset"],
      ["Mô hình", "models/", "Models"],
      ["Kết quả", "results/", "Results"],
      ["Kiến trúc", "architecture/", "Architecture"],
      ["Tài liệu", "docs/", "Docs"],
      ["Lộ trình", "roadmap/", "Roadmap"],
    ]
  : [
      ["Research", "research/", "Research"],
      ["Dataset", "dataset/", "Dataset"],
      ["Models", "models/", "Models"],
      ["Results", "results/", "Results"],
      ["Architecture", "architecture/", "Architecture"],
      ["Docs", "docs/", "Docs"],
      ["Roadmap", "roadmap/", "Roadmap"],
    ];
const copyLabels = isVi
  ? {
      copy: "Sao chép",
      copied: "Đã chép",
      unavailable: "Không khả dụng",
      aria: "Sao chép khối mã",
      switchDark: "Chuyển sang giao diện tối",
      switchLight: "Chuyển sang giao diện sáng",
    }
  : {
      copy: "Copy",
      copied: "Copied",
      unavailable: "Unavailable",
      aria: "Copy code block",
      switchDark: "Switch to dark theme",
      switchLight: "Switch to light theme",
    };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080f1d" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={href("favicon.svg")} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link
      rel="alternate"
      hreflang="vi"
      href={new URL(href(routePath, "vi"), Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(href(routePath, "en"), Astro.site)}
    />
    <title>
      {
        title === "Home" || title === "Trang chủ"
          ? isVi
            ? "Phát hiện Bất thường & Truy vết Mạng · Network Anomaly Detection"
            : "Network Anomaly Detection & Traceability"
          : `${title} | Network Anomaly Detection`
      }
    </title>
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem("research-theme") === "light" ? "light" : "dark";
      } catch {}
    </script>
  </head>
  <body
    data-copy-label={copyLabels.copy}
    data-copied-label={copyLabels.copied}
    data-unavailable-label={copyLabels.unavailable}
    data-copy-aria={copyLabels.aria}
    data-switch-dark={copyLabels.switchDark}
    data-switch-light={copyLabels.switchLight}
  >
    <a class="skip-link" href="#main"
      >{isVi ? "Chuyển tới nội dung" : "Skip to content"}</a
    >
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={href("", lang)}>
          <span class="brand-mark" aria-hidden="true">N<span>∕</span>A</span>
          <span class="brand-name"
            >NETWORK ANOMALY<br /><b
              >{isVi ? "CỔNG NGHIÊN CỨU" : "RESEARCH PORTAL"}</b
            ></span
          >
        </a>
        <nav
          class="desktop-nav"
          aria-label={isVi ? "Điều hướng chính" : "Primary navigation"}
        >
          {
            nav.map(([label, path, key]) => (
              <a
                href={href(path, lang)}
                aria-current={section === key ? "page" : undefined}
              >
                {label}
              </a>
            ))
          }
        </nav>
        <div class="header-actions">
          <div
            class="lang-switch"
            role="group"
            aria-label={isVi ? "Chọn ngôn ngữ" : "Select language"}
          >
            <a
              href={href(routePath, "vi")}
              aria-current={lang === "vi" ? "page" : undefined}
              hreflang="vi"
              lang="vi"
              title="Tiếng Việt">VI</a
            ><a
              href={href(routePath, "en")}
              aria-current={lang === "en" ? "page" : undefined}
              hreflang="en"
              lang="en"
              title="English">EN</a
            >
          </div>
          <button
            class="theme-toggle"
            type="button"
            aria-label={copyLabels.switchLight}
            title={isVi ? "Đổi giao diện sáng/tối" : "Toggle color theme"}
            ><span aria-hidden="true">◐</span></button
          >
          <a
            class="github-link"
            href={repository}
            target="_blank"
            rel="noopener noreferrer"
            >GitHub <span aria-hidden="true">↗</span></a
          >
          <details class="mobile-menu">
            <summary
              aria-label={isVi ? "Mở menu điều hướng" : "Open navigation menu"}
              >Menu <span aria-hidden="true">☰</span></summary
            ><nav aria-label="Mobile navigation">
              {
                nav.map(([label, path, key]) => (
                  <a
                    href={href(path, lang)}
                    aria-current={section === key ? "page" : undefined}
                  >
                    {label}
                  </a>
                ))
              }<a href={repository}>GitHub ↗</a>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer rule">
      <div class="container footer-grid">
        <div>
          <span class="eyebrow"
            >{isVi ? "Prototype nghiên cứu" : "Research prototype"}</span
          ><h2>
            {isVi ? "Bằng chứng trước tuyên bố." : "Evidence before claims."}
          </h2><p>
            {
              isVi
                ? "Cổng thông tin này ghi nhận một hệ thống nghiên cứu đang phát triển. Điểm benchmark phản ánh phép đo thực nghiệm trong phạm vi bộ dữ liệu, không phải bảo đảm vận hành thực tế."
                : "This portal documents a research system in progress. Validation scores are benchmark observations, not operational guarantees."
            }
          </p>
        </div>
        <div>
          <strong>{isVi ? "Khám phá" : "Explore"}</strong><a
            href={href("results/", lang)}
            >{isVi ? "Thực nghiệm & kết quả" : "Experiments & results"}</a
          ><a href={href("docs/", lang)}
            >{isVi ? "Tài liệu kỹ thuật" : "Technical documentation"}</a
          ><a href={href("roadmap/", lang)}
            >{isVi ? "Lộ trình dự án" : "Project roadmap"}</a
          >
        </div>
        <div>
          <strong>{isVi ? "Mã nguồn" : "Source"}</strong><a href={repository}
            >Repository ↗</a
          ><a href={`${repository}/issues`}>Issues ↗</a><a
            href={`${repository}/blob/main/LICENSE`}
            >{
              isVi
                ? "Giấy phép mã nguồn Apache-2.0 ↗"
                : "Apache-2.0 source license ↗"
            }</a
          >
        </div>
      </div>
      <div class="container footer-bottom">
        <span
          >{isVi ? "Ảnh chụp bằng chứng: main @" : "Evidence snapshot: main @"}
          <a href={`${repository}/tree/${evidenceCommit}`}
            >{evidenceCommit.slice(0, 7)}</a
          > · 19 Nov 2026</span
        ><span
          >{
            isVi
              ? "Dữ liệu tuân theo điều khoản sử dụng riêng của nhà xuất bản."
              : "Dataset use follows the publisher's separate terms."
          }</span
        >
      </div>
    </footer>
    <script>
      const body = document.body;
      const button = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const updateLabel = () =>
        button?.setAttribute(
          "aria-label",
          document.documentElement.dataset.theme === "dark"
            ? (body.dataset.switchLight ?? "Switch to light theme")
            : (body.dataset.switchDark ?? "Switch to dark theme"),
        );
      updateLabel();
      button?.addEventListener("click", () => {
        const next =
          document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("research-theme", next);
        } catch {}
        updateLabel();
      });
      const copyLabel = body.dataset.copyLabel ?? "Copy";
      const copiedLabel = body.dataset.copiedLabel ?? "Copied";
      const unavailableLabel = body.dataset.unavailableLabel ?? "Unavailable";
      const copyAria = body.dataset.copyAria ?? "Copy code block";
      document.querySelectorAll<HTMLElement>("pre").forEach((pre) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "copy-code";
        btn.textContent = copyLabel;
        btn.setAttribute("aria-label", copyAria);
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(
              pre.querySelector("code")?.textContent ?? pre.textContent ?? "",
            );
            btn.textContent = copiedLabel;
            setTimeout(() => (btn.textContent = copyLabel), 1800);
          } catch {
            btn.textContent = unavailableLabel;
          }
        });
        pre.append(btn);
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 74px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    border: 1px solid var(--cyan);
    height: 38px;
    width: 38px;
    color: var(--cyan);
    font-weight: 900;
    font-size: 0.8rem;
    letter-spacing: -0.07em;
  }
  .brand-mark span {
    color: var(--violet);
  }
  .brand-name {
    font-size: 0.63rem;
    letter-spacing: 0.11em;
    line-height: 1.2;
    color: var(--muted);
    font-weight: 700;
  }
  .brand-name b {
    color: var(--text);
  }
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-left: auto;
  }
  .desktop-nav a {
    font-size: 0.81rem;
    text-decoration: none;
    color: var(--muted);
    font-weight: 650;
    white-space: nowrap;
  }
  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] {
    color: var(--cyan);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .lang-switch {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: 0.3rem;
    overflow: hidden;
  }
  .lang-switch a {
    padding: 0.32rem 0.5rem;
    font-size: 0.72rem;
    font-weight: 800;
    text-decoration: none;
    color: var(--muted);
    line-height: 1.2;
  }
  .lang-switch a[aria-current="page"] {
    background: var(--cyan);
    color: #071a25;
  }
  :root[data-theme="light"] .lang-switch a[aria-current="page"] {
    color: #fff;
  }
  .theme-toggle {
    height: 34px;
    width: 34px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 0.3rem;
    color: var(--text);
    font-size: 1.25rem;
    line-height: 1;
  }
  .github-link {
    border: 1px solid var(--line);
    border-radius: 0.3rem;
    padding: 0.35rem 0.65rem;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .mobile-menu {
    display: none;
  }
  .site-footer {
    padding-top: 3rem;
    background: var(--surface);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 3rem;
  }
  .footer-grid h2 {
    font-size: 1.6rem;
    margin: 0.7rem 0;
  }
  .footer-grid p {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .footer-grid > div:not(:first-child) {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .footer-grid a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.88rem;
  }
  .footer-grid a:hover {
    color: var(--cyan);
  }
  .footer-bottom {
    border-top: 1px solid var(--line);
    padding: 1rem 0;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.74rem;
  }
  @media (max-width: 1150px) {
    .desktop-nav {
      gap: 0.7rem;
    }
    .desktop-nav a {
      font-size: 0.76rem;
    }
    .brand-name {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .desktop-nav,
    .github-link {
      display: none;
    }
    .header-inner {
      min-height: 64px;
      gap: 0.5rem;
    }
    .header-actions {
      margin-left: auto;
    }
    .brand-name {
      display: block;
    }
    .mobile-menu {
      display: block;
      position: relative;
    }
    .mobile-menu summary {
      list-style: none;
      white-space: nowrap;
      border: 1px solid var(--line);
      border-radius: 0.3rem;
      padding: 0.35rem 0.55rem;
      font-size: 0.82rem;
      cursor: pointer;
    }
    .mobile-menu summary::-webkit-details-marker {
      display: none;
    }
    .mobile-menu nav {
      position: absolute;
      right: 0;
      top: calc(100% + 0.7rem);
      width: min(80vw, 280px);
      display: grid;
      background: var(--surface);
      border: 1px solid var(--line);
      box-shadow: var(--shadow);
      padding: 0.6rem;
      border-radius: 0.4rem;
    }
    .mobile-menu nav a {
      padding: 0.65rem 0.75rem;
      text-decoration: none;
      color: var(--muted);
      border-radius: 0.2rem;
    }
    .mobile-menu nav a:hover,
    .mobile-menu nav a[aria-current="page"] {
      background: var(--surface-2);
      color: var(--cyan);
    }
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .footer-grid > div:first-child {
      grid-column: 1/-1;
    }
    .footer-bottom {
      flex-direction: column;
    }
  }
  @media (max-width: 420px) {
    .brand-name {
      display: none;
    }
  }
</style>
