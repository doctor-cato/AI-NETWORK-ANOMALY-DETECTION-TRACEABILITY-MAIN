{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetFlow Sentinel M6",
  "version": "0.6.0",
  "identifier": "com.networkanomaly.sentinel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NetFlow Sentinel M6 \u2014 Gi\u00e1m s\u00e1t b\u1ea5t th\u01b0\u1eddng l\u01b0u l\u01b0\u1ee3ng m\u1ea1ng",
        "width": 1380,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "../../src/network_anomaly/*.py": "src/network_anomaly/",
      "../../src/network_anomaly/api/*.py": "src/network_anomaly/api/",
      "../../src/network_anomaly/data/*.py": "src/network_anomaly/data/",
      "../../src/network_anomaly/eda/*.py": "src/network_anomaly/eda/",
      "../../src/network_anomaly/evaluation/*.py": "src/network_anomaly/evaluation/",
      "../../src/network_anomaly/features/*.py": "src/network_anomaly/features/",
      "../../src/network_anomaly/inference/*.py": "src/network_anomaly/inference/",
      "../../src/network_anomaly/ingestion/*.py": "src/network_anomaly/ingestion/",
      "../../src/network_anomaly/ingestion/adapters/*.py": "src/network_anomaly/ingestion/adapters/",
      "../../src/network_anomaly/models/*.py": "src/network_anomaly/models/",
      "../../src/network_anomaly/preprocessing/*.py": "src/network_anomaly/preprocessing/",
      "../../src/network_anomaly/visualization/*.py": "src/network_anomaly/visualization/",
      "../../scripts/run_api.py": "scripts/run_api.py",
      "../../scripts/check_environment.py": "scripts/check_environment.py",
      "../../scripts/verify_companion_artifacts.py": "scripts/verify_companion_artifacts.py",
      "../../scripts/prepare_demo_dataset.py": "scripts/prepare_demo_dataset.py",
      "../../scripts/windows_setup_runtime.ps1": "scripts/windows_setup_runtime.ps1",
      "../../pyproject.toml": "pyproject.toml",
      "../../requirements.txt": "requirements.txt",
      "../../requirements-runtime.txt": "requirements-runtime.txt",
      "../../reports/models/*_manifest.json": "reports/models/",
      "../../reports/preprocessing/*_manifest.json": "reports/preprocessing/",
      "../../data/NF_UNSW_NB15_V3_SPLIT_MANIFEST.json": "data/NF_UNSW_NB15_V3_SPLIT_MANIFEST.json",
      "../../data/NF_UNSW_NB15_V3_MANIFEST.json": "data/NF_UNSW_NB15_V3_MANIFEST.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
