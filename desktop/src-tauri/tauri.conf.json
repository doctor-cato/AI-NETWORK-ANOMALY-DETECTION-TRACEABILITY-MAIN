{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetFlow Sentinel M6",
  "version": "0.6.0",
  "identifier": "com.networkanomaly.sentinel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NetFlow Sentinel M6 \u2014 Gi\u00e1m s\u00e1t b\u1ea5t th\u01b0\u1eddng l\u01b0u l\u01b0\u1ee3ng m\u1ea1ng",
        "width": 1380,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
