{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetFlow Sentinel",
  "version": "2.0.0",
  "identifier": "com.networkanomaly.sentinel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NetFlow Sentinel v2.0.0 \u2014 Ph\u00e2n t\u00edch B\u1ea5t th\u01b0\u1eddng L\u01b0u l\u01b0\u1ee3ng M\u1ea1ng",
        "width": 880,
        "height": 460,
        "minWidth": 800,
        "minHeight": 420,
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "../../reports/models/*_manifest.json": "reports/models/",
      "../../reports/preprocessing/*_manifest.json": "reports/preprocessing/",
      "../../data/V2_SPLIT_MANIFEST.json": "data/V2_SPLIT_MANIFEST.json",
      "../../data/AIT_DATASETS_MANIFEST.json": "data/AIT_DATASETS_MANIFEST.json",
      "../../data/CTU_SME_11_MANIFEST.json": "data/CTU_SME_11_MANIFEST.json",
      "../../NOTICE": "NOTICE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../LICENSE": "LICENSE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
