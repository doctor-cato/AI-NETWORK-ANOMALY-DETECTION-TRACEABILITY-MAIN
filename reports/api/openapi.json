  },
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "events": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "minItems": 1,
            "title": "Events",
            "description": "List of flow records to analyze"
          },
          "model_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Name",
            "description": "Model family: 'random_forest' or 'isolation_forest'",
            "default": "random_forest"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Threshold",
            "description": "Decision threshold for binary anomaly",
            "default": 0.5
          },
          "create_incidents": {
            "type": "boolean",
            "title": "Create Incidents",
            "description": "Whether to automatically create incident records for high anomalies",
            "default": true
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "events"
        ],
        "title": "AnalyzeRequest",
        "description": "Request payload for anomaly detection inference."
      },
      "AnalyzeResponse": {
        "properties": {
          "model_ready": {
            "type": "boolean",
            "title": "Model Ready",
            "description": "Whether verified production model was used"
          },
          "count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Count",
            "description": "Number of analyzed items"
          },
          "anomalies_detected": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Anomalies Detected",
            "description": "Number of items classified as anomalous"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/AnalyzeResultItem"
            },
            "type": "array",
            "title": "Results"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model_ready",
          "count",
          "anomalies_detected",
          "timestamp"
        ],
        "title": "AnalyzeResponse",
        "description": "Response returned from analysis inference."
      },
      "AnalyzeResultItem": {
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Index",
            "description": "Row index in input batch"
          },
          "event_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Id",
            "description": "Associated event ID if provided"
          },
          "is_anomaly": {
            "type": "boolean",
            "title": "Is Anomaly",
            "description": "True if anomaly score exceeds threshold"
          },
          "anomaly_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Anomaly Score",
            "description": "Calibrated anomaly score or attack probability [0, 1]"
          },
          "prediction": {
            "type": "integer",
            "title": "Prediction",
            "description": "Binary prediction: 0 (Normal), 1 (Anomaly)"
          },
          "attack_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attack Type",
            "description": "Inferred or classified attack category"
          },
          "model_used": {
            "type": "string",
            "title": "Model Used",
            "description": "Model identifier used for analysis"
          },
          "incident_created": {
            "type": "boolean",
            "title": "Incident Created",
            "description": "Whether an incident was persisted for this flow",
            "default": false
          },
          "incident_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Incident Id",
            "description": "Generated incident ID if created"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "index",
          "is_anomaly",
          "anomaly_score",
          "prediction",
          "model_used"
        ],
        "title": "AnalyzeResultItem",
        "description": "Single inference result row."
      },
      "FlowEventInput": {
        "properties": {
          "event_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Id",
            "description": "Client-supplied or auto-generated event ID"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "Optional associated session ID"
          },
          "timestamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp",
            "description": "ISO 8601 event timestamp"
          },
          "source_ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Ip",
            "description": "Source IPv4 address"
          },
          "dest_ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dest Ip",
            "description": "Destination IPv4 address"
          },
          "source_port": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 65535.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Port",
            "description": "Source L4 port"
          },
          "dest_port": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 65535.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Dest Port",
            "description": "Destination L4 port"
          },
          "protocol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Protocol",
            "description": "L4 transport protocol"
          },
          "features": {
            "additionalProperties": true,
            "type": "object",
            "title": "Features",
            "description": "Baseline ML features or raw telemetry"
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata",
            "description": "Trace and operational metadata"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "title": "FlowEventInput",
        "description": "Input representation of a network flow event."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Overall status: 'healthy' or 'degraded'"
          },
          "process_alive": {
            "type": "boolean",
            "title": "Process Alive",
            "description": "Indicates if the API server process is responding",
            "default": true
          },
          "model_ready": {
            "type": "boolean",
            "title": "Model Ready",
            "description": "Indicates if ML model artifact is loaded and verified"
          },
          "preprocessor_ready": {
            "type": "boolean",
            "title": "Preprocessor Ready",
            "description": "Indicates if preprocessor artifact is loaded and verified"
          },
          "db_ready": {
            "type": "boolean",
            "title": "Db Ready",
            "description": "Indicates if SQLite persistence layer is operational"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Package version"
          },
          "git_commit": {
            "type": "string",
            "title": "Git Commit",
            "description": "Git commit SHA",
            "default": "unknown"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp",
            "description": "Current ISO 8601 UTC timestamp"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details",
            "description": "Component diagnostics details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "model_ready",
          "preprocessor_ready",
          "db_ready",
          "version",
          "timestamp"
        ],
        "title": "HealthResponse",
        "description": "Schema for health and readiness checks."
      },
      "IncidentCreateRequest": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3,
            "title": "Title"
          },
          "severity": {
            "type": "string",
            "title": "Severity",
            "description": "LOW, MEDIUM, HIGH, CRITICAL",
            "default": "MEDIUM"
          },
          "anomaly_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Anomaly Score"
          },
          "attack_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
