# Git exclusions

# Dataset — do NOT commit UNSW-NB15 or large files
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Artifacts / models / outputs — ignore everything, keep only the directory markers
artifacts/**
!artifacts/.gitkeep

reports/figures/**
!reports/figures/.gitkeep

# Environment / secrets
.env
.env.local
secrets/
*.key
*.pem
credentials*.json
.venv/
env/
venv/
__pycache__/
.pytest_cache/
.pytest-tmp/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Jupyter / notebooks outputs (optional; can allow if needed)
**/.ipynb_checkpoints/

# Logs
*.log
logs/

# Local session audit evidence (preserve on disk; not project source)
/AUDIT_REPORT.md
/AUDIT_LEDGER.md
/docs/audits/
