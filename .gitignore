# Git exclusions

# Dataset — do NOT commit UNSW-NB15 or large files
data/raw/*
data/interim/*
data/processed/*
data/demo/*
data/historical/nf_unsw_nb15_v3/splits/*
data/historical/nf_unsw_nb15_v3/demo/*.csv
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/demo/.gitkeep

# Artifacts / models / outputs — ignore everything, keep only the directory markers
artifacts/**
!artifacts/.gitkeep

reports/figures/**
!reports/figures/.gitkeep

# Environment / secrets
.env
.env.local
secrets/
data/keys/
*.key
*.pem
credentials*.json
*.db
*.sqlite
*.sqlite3
.venv/
env/
venv/
__pycache__/
.pytest_cache/
.pytest-tmp/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Jupyter / notebooks outputs (optional; can allow if needed)
**/.ipynb_checkpoints/

# Logs
*.log
logs/

# The EDA reproducibility evidence keeps the captured stdout and stderr of the
# two recorded real-data runs; they are part of the reviewable evidence.
!reports/eda/evidence/**/stdout.log
!reports/eda/evidence/**/stderr.log

# Local session audit evidence (preserve on disk; not project source)
/AUDIT_REPORT.md
/AUDIT_LEDGER.md

# Agent session artifacts
.agents/checkpoints/
.agents/teamwork/

# Desktop app (Svelte/Vite + Tauri 2 Rust build artifacts)
desktop/node_modules/
desktop/dist/
desktop/.svelte-kit/
desktop/src-tauri/gen/
desktop/src-tauri/target/
desktop/src-tauri/binaries/*.exe
desktop/src-tauri/staged_bundle/
desktop/*.log
*.spec
